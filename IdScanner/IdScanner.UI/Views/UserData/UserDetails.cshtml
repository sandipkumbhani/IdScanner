@model IdScanner.Domain.Model.UserData
@{
    Layout = null;
    string photoUrl = ViewBag.photoUrl;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Indian Railways ID – Approved</title>
    <link rel="stylesheet" href="styles.css" />
    <link href="~/css/userdetails.css" rel="stylesheet" />
</head>
<body>
    <main class="card">
        <div class="status approved">APPROVED</div>
        <header class="header">
            <div class="logo-box">
                <img class="logo" src="@Model.CompanyMaster.logo" alt="Company Logo" />
            </div>
            <div class="header-text">
                <h1>@Model.CompanyMaster.CompanyName</h1>
                <p class="sub">Bengaluru Division</p>
                <p class="dept">@Model.Department.DepartmentName</p>
            </div>
        </header>
        <div class="info-bar">
            <span>CATG / ID No: <strong>100002</strong> / Stn: <strong>SBC</strong></span>
        </div>
        <section class="photo-wrap">
            <img class="photo" src="@photoUrl" alt="User Photograph" />
            @* <div class="userPhoto photo"></div> *@
        </section>
        <h2 class="name">@Model.Name</h2>
        <section class="main-section">
            <div class="details">
                <div class="row">
                    <span class="label">Designation:</span>
                    <span class="value">@Model.Designation</span>
                </div>
                <div class="row">
                    <span class="label">ID Number:</span>
                    <span class="value">@Model.IdNumber</span>
                </div>
                <div class="row">
                    <span class="label">Mob No:</span>
                    <span class="value">@Model.MobileNumber</span>
                </div>
                <div class="row">
                    <span class="label">STALL/PF No:</span>
                    <span class="value">@Model.StallPfNumber</span>
                </div>
                <div class="row">
                    <span class="label">Licensee:</span>
                    <span class="value">@Model.Licensee</span>
                </div>
                <div class="row">
                    <span class="label">Work Slot:</span>
                    <span class="value">@Model.WorkSlot</span>
                </div>
                <div class="row">
                    <span class="label">ID Valid Till:</span>
                    <span class="value">@($"{Model.IdValidTill:yyyy-MM-dd}")</span>
                </div>
            </div>
            <div class="approval">
                <img class="shield" src="@Model.CompanyMaster.logo" alt="Approval Shield" />
                <div class="approval-text">
                    <p>
                        Digitally approved<br />
                        on 26.07.2025 by<br />
                        <strong>Navin Testing</strong><br />
                        <span><strong>ACM SBC (Testing)</strong></span>
                    </p>
                </div>
            </div>
        </section>
        <section class="bottom-section">
            <!-- Links -->
            <div class="links">
                <a href="@Model.PoliceVerificationCertificateUrl" class="doc-link" target="_blank">Police Verification Certificate</a>
                <a href="@Model.MedicalCertificateUrl" class="doc-link" target="_blank">Medical Certificate</a>
            </div>
            <div class="footer">
                <p class="powered">Powered By</p>
                <img class="brand" src="@Model.CompanyMaster.logo" alt="mobile offize logo" />
            </div>
        </section>
    </main>
</body>
</html>