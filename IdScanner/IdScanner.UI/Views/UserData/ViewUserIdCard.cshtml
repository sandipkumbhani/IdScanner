@model IdScanner.Domain.Model.UserData

@{
    Layout = null;
    IList<IdScanner.Domain.Model.UserData> UserDataList = ViewBag.UserDataList;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ID Card</title>
    <link href="~/css/viewicard.css" rel="stylesheet" />
</head>
<body>
    @foreach (var user in UserDataList)
    {
        <div class="id-row">
            <!-- FRONT SIDE -->
            <div class="id-card front">
                <div class="header">
                    <img src="@user.CompanyMaster.logo" class="rail-logo" alt="Logo" />
                    <div>
                        <h3>@user.CompanyMaster.CompanyName</h3>
                        <p class="department_text">@user.Department.DepartmentName</p>
                        <p class="id-num">ID Card No: @user.IdNumber</p>
                    </div>
                </div>

                <div class="photo">
                    <img src="@user.CompanyMaster.logo" alt="User Photo" />
                </div>

                <div class="signature">
					@* <img src="@user.SignatureUrl" alt="Signature" /> *@
                    <img src="~/images\signature_image.png" />
                </div>

                <div class="name">@user.Name</div>

                <div class="footer">
                    <div class="approved">
                        <img src="@user.CompanyMaster.logo" />
                        <span>Digitally <br> Approved</span>
                    </div>
                    <div class="authority">
                        <strong>Navin Testing</strong><br />
                        ACM SBC (Testing)<br />
                        Issuing Authority
                    </div>
                </div>
            </div>

            <!-- BACK SIDE -->
            <div class="id-card back">
                <div class="top">
                    <div class="qr">
                        <img src="@Url.Content(user.QRCodeUrl)" alt="QR Code" />
                    </div>
                    <div class="blood">AB+</div>
                </div>

                <div class="highlight">@user.Department.DepartmentName</div>

                <div class="contact">
                    <p>@user.MobileNumber</p>
                    <p class="masked">@user.AadhaarCardNumber</p>
                </div>

                <div class="note">
                    IMPORTANT: Please surrender to issuing authority in case of misplacement of ID card.
                </div>

                <div class="logo">
                    <img src="~/images/partner.png" alt="Footer Logo" />
                </div>
            </div>
        </div>
    }
</body>
</html>
