@model IdScanner.Domain.Model.UserData

@{
    Layout = null;
    IList<IdScanner.Domain.Model.UserData> UserDataList = ViewBag.UserDataList;
    string photoUrl = ViewBag.photoUrl;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ID Card</title>
    <link href="~/css/viewicard.css" rel="stylesheet" />
</head>
<body>
    
    @foreach (var user in UserDataList)
    {
        <div class="id-row">
            <div class="id-card front">
                <div class="header">
                    <img src="@user.CompanyMaster.logo" class="rail-logo" alt="Logo" />
                    <div>
                        <h3>@user.CompanyMaster.CompanyName</h3>
                        <p class="department_text">@user.Department.DepartmentName</p>
                        <p class="id-num">ID Card No: @user.IdNumber</p>
                    </div>
                </div>

                <div class="photo">
                    @* <img src="@user.PhotoUrl" alt="User Photo" /> *@
                    <img src="/drive/image/@user.PhotoUrl" alt="Drive Image" />
                </div>
                <div class="signature">
                    @* <img src="@user.SignatureUrl" alt="Signature" /> *@
                    <img src="/drive/image/@user.SignatureUrl" alt="Drive Image" />
                </div>
                <div class="name">@user.Name</div>

                <div class="footer">
                    <div class="approved">
                        <img src="@user.CompanyMaster.logo" />
                        <span>Digitally <br> Approved</span>
                    </div>
                    <div class="authority">
                        <strong>Navin Testing</strong><br />
                        ACM SBC (Testing)<br />
                        Issuing Authority
                    </div>
                </div>
            </div>

            <!-- BACK SIDE -->
            <div class="id-card back">
                <div class="top">
                    <div class="qr">
                        <img src="@Url.Content(user.QRCodeUrl)" alt="QR Code" />
                    </div>
                    <div class="blood">@user.BloodGroup</div>
                </div>

                <div class="highlight">@user.Department.DepartmentName</div>

                <div class="contact">
                    <p class="mobile_number">@user.MobileNumber</p>
                    <p class="aadhar_number">
                        @("XXXX-XXXX-" + user.AadhaarCardNumber?.Substring(user.AadhaarCardNumber.Length - 4))
                    </p>
                </div>

                <div class="footer-bottom">
                    <div class="note">
                        IMPORTANT: Please surrender to issuing authority on completion/termination of contractual service.
                    </div>
                    <div class="logo">
                        <span>power by</span>
                        <img src="@user.CompanyMaster.logo" alt="Footer Logo" />
                    </div>
                </div>
            </div>
        </div>
    }
</body>
</html>
