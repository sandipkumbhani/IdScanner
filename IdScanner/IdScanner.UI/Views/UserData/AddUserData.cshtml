@model IdScanner.Domain.Model.UserData
@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	IList<IdScanner.Domain.Model.CompanyMaster> CompanyMasterList = ViewBag.CompanyList;
	string NameMsg = ViewBag.NameMsg;
	string MobileNumberMsg = ViewBag.MobileNumberMsg;
	string DesignationMsg = ViewBag.DesignationMsg;
	string StallPfNumberMsg = ViewBag.StallPfNumberMsg;
	string WorkSlotMsg = ViewBag.WorkSlotMsg;
	string AadhaarCardNumberMsg = ViewBag.AadharNumberMsg;
	string LicenseeMsg = ViewBag.LicenseeMsg;
	string MobileMsg = string.Empty;
	Layout = "~/Views/Shared/_Layout.cshtml";

}
<style>
	.content-page {
		margin-left: 144px;
	}
</style>
<html>
<head>
	<title>IdScanner | Add User Data</title>
</head>
<body>
	<div class="content-page">
		<div class="content">
			<div class="main-inner container-fluid">
				<div class="row">
					<div class="col-12">
						<div class="page-title-box">
							<h1 class="page-title">Add User Data</h1>
						</div>
					</div>
				</div>
				<div class="row">
					<div class="col-12">
						<div class="card com-profile-info">
							<div class="top-details">
								<h2 class="page-form-title">User Details</h2>
								<form class="row all-custom-class" method="post" action="@Url.Action("AddUserData", "UserData")" enctype="multipart/form-data">
									<div class="col-xl-4 col-lg-6">
										<div class="item-input">
											<input type="text" hidden id="UserDataId" name="UserDataId" value="@Model.UserDataId" />

											<label for="name" class="form-label col-form-label required fw-semibold fs-6">Name</label>
											<input type="text" class="form-control userinput" id="Name" name="name" value="@Model.Name">
											@if (!string.IsNullOrEmpty(NameMsg))
											{
												<span class="text-danger">@NameMsg</span>
											}
										</div>
									</div>
									<div class="col-xl-4 col-lg-6">
										<div class="item-input">
											<label for="text" class="form-label col-form-label required fw-semibold fs-6">Mobile Number</label>
											<input type="number" class="form-control userinput" id="MobileNumber" name="MobileNumber" value="@Model.MobileNumber" oninput="if(this.value.length > 10) this.value = this.value.slice(0, 10);" onblur="validateMobile(this)">
											@if (!string.IsNullOrEmpty(MobileNumberMsg))
											{
												<span class="text-danger">@MobileNumberMsg</span>
											}
											<span id="MobileMsg" class="text-danger"></span>
										</div>
									</div>
									<div class="col-xl-4 col-lg-6">
										<div class="item-input">
											<label for="Designation" class="form-label col-form-label required fw-semibold fs-6">Designation</label>
											<input type="text" class="form-control userinput" id="Designation" name="Designation" value="@Model.Designation">
											@if (!string.IsNullOrEmpty(DesignationMsg))
											{
												<span class="text-danger">@DesignationMsg</span>
											}
										</div>
									</div>
									<div class="col-xl-4 col-lg-6">
										<div class="item-input">
											<label for="StallPfNumber" class="form-label col-form-label required fw-semibold fs-6">StallPfNumber</label>
											<input type="text" class="form-control userinput" id="StallPfNumber" name="StallPfNumber" value="@Model.StallPfNumber">
											@if (!string.IsNullOrEmpty(StallPfNumberMsg))
											{
												<span class="text-danger">@StallPfNumberMsg</span>
											}
										</div>
									</div>
									<div class="col-xl-4 col-lg-6">
										<div class="item-input">
											<label for="WorkSlot" class="form-label col-form-label required fw-semibold fs-6">WorkSlot</label>
											<input type="text" class="form-control userinput" id="WorkSlot" name="WorkSlot" value="@Model.WorkSlot">
											@if (!string.IsNullOrEmpty(WorkSlotMsg))
											{
												<span class="text-danger">@WorkSlotMsg</span>
											}
										</div>
									</div>
									<div class="col-xl-4 col-lg-6">
										<div class="item-input">
											<label for="AadhaarCardNumber" class="form-label col-form-label required fw-semibold fs-6">AadhaarCardNumber</label>
											<input type="number" class="form-control userinput" id="AadhaarCardNumber" name="AadhaarCardNumber" value="@Model.AadhaarCardNumber"
												   oninput="if(this.value.length > 12) this.value = this.value.slice(0, 12);"
												   onblur="validateAadharNumber(this)">
											@if (!string.IsNullOrEmpty(AadhaarCardNumberMsg))
											{
												<span class="text-danger">@AadhaarCardNumberMsg</span>
											}
											<span id="AadharNumberMsg" class="text-danger"></span>
										</div>
									</div>
									<div class="col-xl-4 col-lg-6">
										<div class="item-input">
											@* <label for="BloodGroup" class="form-label col-form-label required fw-semibold fs-6">Blood Group</label>
											<select class="form-select" id="BloodGroup" name="BloodGroup">
												<option value="">-- Select Blood Group --</option>
												<option value="A+">A+</option>
												<option value="A-">A-</option>
												<option value="B+">B+</option>
												<option value="B-">B-</option>
												<option value="O+">O+</option>
												<option value="O-">O-</option>
												<option value="AB+">AB+</option>
												<option value="AB-">AB-</option>
											</select>


											<span class="text-danger">@ViewBag.BloodGroupMsg</span> *@

											<label for="BloodGroup" class="form-label col-form-label required fw-semibold fs-6">Blood Group</label>
											<select class="form-select" id="BloodGroup" name="BloodGroup">
												<option value="" selected="@(string.IsNullOrEmpty(Model.BloodGroup) ? "selected" : null)">
													-- Select Blood Group --
												</option>

												<option value="A+" selected="@(Model.BloodGroup == "A+" ? "selected" : null)">A+</option>
												<option value="A-" selected="@(Model.BloodGroup == "A-" ? "selected" : null)">A-</option>
												<option value="B+" selected="@(Model.BloodGroup == "B+" ? "selected" : null)">B+</option>
												<option value="B-" selected="@(Model.BloodGroup == "B-" ? "selected" : null)">B-</option>
												<option value="O+" selected="@(Model.BloodGroup == "O+" ? "selected" : null)">O+</option>
												<option value="O-" selected="@(Model.BloodGroup == "O-" ? "selected" : null)">O-</option>
												<option value="AB+" selected="@(Model.BloodGroup == "AB+" ? "selected" : null)">AB+</option>
												<option value="AB-" selected="@(Model.BloodGroup == "AB-" ? "selected" : null)">AB-</option>
											</select>

											<span class="text-danger">@ViewBag.BloodGroupMsg</span>

										</div>
									</div>

									<div class="col-xl-4 col-lg-6">
										<div class="item-input">
											<label for="Licensee" class="form-label col-form-label required fw-semibold fs-6">Licensee</label>
											<input type="text" class="form-control userinput" id="Licensee" name="Licensee" value="@Model.Licensee">
											@if (!string.IsNullOrEmpty(LicenseeMsg))
											{
												<span class="text-danger">@LicenseeMsg</span>
											}
										</div>
									</div>
									<div class="col-xl-4 col-lg-6">
										<div class="item-input">
											<label for="IdValidTill" class="form-label col-form-label required fw-semibold fs-6">IdValidTill</label>
											<input type="date" class="form-control userinput"
												   id="IdValidTill" name="IdValidTill"
												   value="@(Model.IdValidTill.HasValue? Model.IdValidTill.Value.ToString("yyyy-MM-dd") : "")"
												   min="@DateTime.Now.ToString("yyyy-MM-dd")" />

											@if (ViewBag.IdValidTillMsg != null)
											{
												<span class="text-danger">@ViewBag.IdValidTillMsg</span>
											}
										</div>
									</div>
									<div class="col-xl-4 col-lg-6">
										<div class="item-input">
											<label for="CompanyId" class="form-label col-form-label required fw-semibold fs-6">Company</label>
											<select class="form-select" id="CompanyId" name="CompanyId">
												<option value="0" selected="@(Model.CompanyId == 0 ? "selected" : null)">-select-</option>
												@foreach (var item in CompanyMasterList)
												{
													<option value="@item.CompanyId" selected="@(Model.CompanyId == item.CompanyId? "selected" : null)">
														@item.CompanyName
													</option>
												}

											</select>
											<span class="text-danger">@ViewBag.CompanyMsg</span>
										</div>
									</div>
									<div class="col-xl-4 col-lg-6">
										<div class="item-input">
											<label for="DE" class="form-label col-form-label required fw-semibold fs-6">Department</label>
											<select class="form-select" id="" name="DepartmentId">
												@* <option value="0" selected="@(Model.DepartmentId == 0 ? "selected" : null)">-select-</option>
                                                @foreach (var item in DepartmentList)
                                                {
                                                    <option value="@item.DepartmentId" selected="@(Model.DepartmentId == item.DepartmentId? "selected" : null)">
                                                        @item.DepartmentName
                                                    </option>
                                                } *@
											</select>
											<span class="text-danger">@ViewBag.DepartmentMsg</span>
										</div>
									</div>
									<div class="col-xl-4 col-lg-6">
										<div class="item-input">
											<label for="ImageFile" class="form-label col-form-label required fw-semibold fs-6">Profile Image</label>

											@* Show previously uploaded file if it exists *@

											<input type="file" class="form-control userinput" id="ImageFile" name="ImageFile" accept="image/*" />
											@* @if (!string.IsNullOrEmpty(Model.PhotoFileName))
											{
												<p>
													Current file:
													<a href="@Url.Content(Model.PhotoUrl)" target="_blank">@Model.PhotoFileName</a>
												</p>
											} *@
											<span class="text-danger">@ViewBag.ImageFileRequiredMsg</span>
											<span id="ImageFileError" class="text-danger"></span>
										</div>
									</div>
									<div class="col-xl-4 col-lg-6">
										<div class="item-input">
											<label for="policeFile" class="form-label col-form-label required fw-semibold fs-6">Police Verification Certificate</label>
											<input type="file" class="form-control userinput" id="policeFile" name="policeFile" accept="image/*" />
											<span class="text-danger">@ViewBag.policeFileRequiredMsg</span>
											<span id="policeFileError" class="text-danger"></span>
										</div>
									</div>
									<div class="col-xl-4 col-lg-6">
										<div class="item-input">
											<label for="medicalFile" class="form-label col-form-label required fw-semibold fs-6">Medical Certificate</label>
											<input type="file" class="form-control userinput" id="medicalFile" name="medicalFile" accept="image/*" />
											<span class="text-danger">@ViewBag.medicalFileFileRequiredMsg</span>
											<span id="medicalFileError" class="text-danger"></span>
										</div>
									</div>
									<div class="col-xl-4 col-lg-6">
										<div class="item-input">
											<label for="signatureFile" class="form-label col-form-label required fw-semibold fs-6">Signature</label>
											<input type="file" class="form-control userinput" id="signatureFile" name="signatureFile" accept="image/*" />
											<span class="text-danger">@ViewBag.signatureFileFileRequiredMsg</span>
											<span id="signatureFileFileError" class="text-danger"></span>
										</div>
									</div>
									<div class="button-main" style="display: flex; gap: 12px; margin-top: 20px;">
										<button type="submit" class="card-link">
											<i class="ri-save-line"></i>
											<span>
												Save
											</span>
										</button>
										@if (Model.UserDataId == 0 || Model.UserDataId == null)
										{
											<button type="reset" class="card-link outline-bar">
												<svg width="16" height="16" viewBox="0 0 23 22" fill="none" xmlns="http://www.w3.org/2000/svg">
													<path d="M19.8166 18.6828L18.6779 12.1172H19.0625C19.3719 12.1172 19.6211 11.868 19.6211 11.5586V7.43359C19.6211 7.12422 19.3719 6.875 19.0625 6.875H13.7773V2.96484C13.7773 2.65547 13.5281 2.40625 13.2188 2.40625H9.78125C9.47188 2.40625 9.22266 2.65547 9.22266 2.96484V6.875H3.9375C3.62813 6.875 3.37891 7.12422 3.37891 7.43359V11.5586C3.37891 11.868 3.62813 12.1172 3.9375 12.1172H4.32207L3.1834 18.6828C3.17695 18.715 3.1748 18.7473 3.1748 18.7773C3.1748 19.0867 3.42402 19.3359 3.7334 19.3359H19.2666C19.2988 19.3359 19.3311 19.3338 19.3611 19.3273C19.6662 19.2758 19.8703 18.9857 19.8166 18.6828ZM4.88281 8.37891H10.7266V3.91016H12.2734V8.37891H18.1172V10.6133H4.88281V8.37891ZM14.9375 17.832V14.4805C14.9375 14.3859 14.8602 14.3086 14.7656 14.3086H13.7344C13.6398 14.3086 13.5625 14.3859 13.5625 14.4805V17.832H9.4375V14.4805C9.4375 14.3859 9.36016 14.3086 9.26562 14.3086H8.23438C8.13984 14.3086 8.0625 14.3859 8.0625 14.4805V17.832H4.85703L5.82598 12.2461H17.1719L18.1408 17.832H14.9375Z" fill="#0466C8" />
												</svg>
												<span>Clear</span>
											</button>
										}
										<a href="@Url.Action("UserDataList", "UserData")" class="card-link outline-bar" />
										<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye" viewBox="0 0 16 16">
											<path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z" />
											<path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0" />
										</svg>
										<span>View</span>
									</div>
								</form>
							</div>

						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<script type="text/javascript">
		document.addEventListener("DOMContentLoaded", function () {
			const companyDropdown = document.getElementById("CompanyId");
			const departmentDropdown = document.querySelector("select[name='DepartmentId']");
			const selectedDeptId = "@Model.DepartmentId";

			function loadDepartments(companyId, preselectId = null) {
				if (!companyId || companyId === "0") {
					departmentDropdown.innerHTML = '<option value="0">-select-</option>';
					return;
				}

				fetch(`/UserData/GetDepartmentsByCompany?companyId=${companyId}`)
					.then(res => res.json())
					.then(data => {
						departmentDropdown.innerHTML = '<option value="0">-select-</option>';
						data.forEach(d => {
							const opt = document.createElement("option");
							opt.value = d.departmentId;
							opt.text = d.departmentName;
							if (preselectId && d.departmentId == preselectId) {
								opt.selected = true;
							}
							departmentDropdown.appendChild(opt);
						});
					});
			}

			if (companyDropdown.value !== "0") {
				loadDepartments(companyDropdown.value, selectedDeptId);
			}

			companyDropdown.addEventListener("change", function () {
				loadDepartments(this.value);
			});
		});

				document.addEventListener("DOMContentLoaded", function () {
			const bloodGroupDropdown = document.getElementById("BloodGroup");

			const hasError = document.querySelector(".text-danger");

			if (hasError && hasError.textContent.trim() !== "") {
				const savedValue = localStorage.getItem("BloodGroup");
				if (savedValue) {
					bloodGroupDropdown.value = savedValue;
				}
			} else {
				localStorage.removeItem("BloodGroup");
			}
			bloodGroupDropdown.addEventListener("change", function () {
				localStorage.setItem("BloodGroup", this.value);
			});
		});


		  document.getElementById("ImageFile").addEventListener("change", function () {
		  const file = this.files[0];
		  const errorSpan = document.getElementById("ImageFileError");
		  errorSpan.textContent = "";

		  if (file) {
			const allowedExtensions = /\.(jpg|jpeg|png|pdf)$/i;
			const maxSize = 100 * 1024;

			if (!allowedExtensions.exec(file.name)) {
			  errorSpan.textContent = "Only .jpg, .jpeg, .png, .pdf files are allowed for Image.";
			  this.value = "";
			} else if (file.size > maxSize) {
			  errorSpan.textContent = "Image file size should not exceed 100 KB.";
			  this.value = "";
			}
		  }
		});

		document.getElementById("policeFile").addEventListener("change", function () {
		  const file = this.files[0];
		  const errorSpan = document.getElementById("policeFileError");
		  errorSpan.textContent = "";

		  if (file) {
			const allowedExtensions = /\.(jpg|jpeg|png|pdf)$/i;
			const maxSize = 200 * 1024;

			if (!allowedExtensions.exec(file.name)) {
			  errorSpan.textContent = "Only .jpg, .jpeg, .png, .pdf files are allowed for Image.";
			  this.value = "";
			} else if (file.size > maxSize) {
			  errorSpan.textContent = "Image file size should not exceed 200 KB.";
			  this.value = "";
			}
		  }
		});

		document.getElementById("medicalFile").addEventListener("change", function () {
		  const file = this.files[0];
		  const errorSpan = document.getElementById("medicalFileError");
		  errorSpan.textContent = "";

		  if (file) {
			const allowedExtensions = /\.(jpg|jpeg|png|pdf)$/i;
			const maxSize = 200 * 1024;

			if (!allowedExtensions.exec(file.name)) {
			  errorSpan.textContent = "Only .jpg, .jpeg, .png, .pdf files are allowed for Image.";
			  this.value = "";
			} else if (file.size > maxSize) {
			  errorSpan.textContent = "Image file size should not exceed 200 KB.";
			  this.value = "";
			}
		  }
		});
		document.getElementById("signatureFile").addEventListener("change", function () {
			const file = this.files[0];
			const errorSpan = document.getElementById("signatureFileFileError");
			errorSpan.textContent = "";

			if (file) {
				const allowedExtensions = /\.(jpg|jpeg|png|pdf)$/i;
				const maxSize = 200 * 1024;

				if (!allowedExtensions.exec(file.name)) {
					errorSpan.textContent = "Only .jpg, .jpeg, .png, .pdf files are allowed for Image.";
					this.value = "";
				} else if (file.size > maxSize) {
					errorSpan.textContent = "Image file size should not exceed 200 KB.";
					this.value = "";
				}
			}
		});

			function validateMobile(input) {
			const msg = document.getElementById("MobileMsg");
			if (input.value.length !== 10) {
				msg.textContent = "Please enter exactly 10 digits";
				input.value = "";
			} else {
				msg.textContent = "";
			}
		}

				function validateAadharNumber(input) {
			const msg = document.getElementById("AadharNumberMsg");
			if (input.value.length !== 12) {
				msg.textContent = "Aadhar number must be exactly 12 digits.";
			} else {
				msg.textContent = "";
			}
		}

	</script>

</body>
</html>
