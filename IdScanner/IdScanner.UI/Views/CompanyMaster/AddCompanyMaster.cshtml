@model IdScanner.Domain.Model.CompanyMaster

@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	string NameMsg = ViewBag.NameMsg;
	string CityMsg = ViewBag.CityMsg;
	string LogoMsg = ViewBag.LogoMsg;
	string userRole = ViewBag.UserRole as string ?? "";
	bool isAdmin = string.Equals(userRole, "Admin", StringComparison.OrdinalIgnoreCase);
	bool isNew = Model.CompanyId == 0;
	bool isChecked = Model.IsActive || (isAdmin && isNew);
}
<html>
<head>
	<title>IdScanner | Add Company</title>
</head>
<body>
	<div class="content-page">
		<div class="content">
			<div class="main-inner container-fluid">
				<div class="row">
					<div class="col-12">
						<div class="card com-profile-info">
							<div class="top-details">
								<h2 class="page-form-title">Company Details</h2>
								<form class="row all-custom-class" method="post" action="@Url.Action("AddSociety", "Society")" enctype="multipart/form-data">

									<!-- Row 1: Company Name + City -->
									<div class="col-md-6 mb-3">
										<div class="item-input">
											<input type="hidden" id="CompanyId" name="CompanyId" value="@Model.CompanyId" />
											<label for="CompanyName" class="form-label required fw-semibold fs-6">Company Name</label>
											<input type="text" class="form-control userinput" id="CompanyName" name="CompanyName" value="@Model.CompanyName">
											@if (!string.IsNullOrEmpty(NameMsg))
											{
												<span class="text-danger">@NameMsg</span>
											}
										</div>
									</div>

									<div class="col-md-6 mb-3">
										<div class="item-input">
											<label for="City" class="form-label required fw-semibold fs-6">City</label>
											<input type="text" class="form-control userinput" id="City" name="City" value="@Model.City">
											@if (!string.IsNullOrEmpty(CityMsg))
											{
												<span class="text-danger">@CityMsg</span>
											}
										</div>
									</div>

									<!-- Row 2: Logo + IsActive -->
									<div class="col-md-6 mb-3">
										<div class="item-input">
											<label for="Logo" class="form-label required fw-semibold fs-6">Logo</label>
											<input type="file" class="form-control userinput" id="ImageFile" name="ImageFile" accept="image/*" />
											@if (!string.IsNullOrEmpty(LogoMsg))
											{
												<span class="text-danger">@LogoMsg</span>
											}
										</div>
									</div>

									<div class="col-md-6 mb-3 d-flex align-items-center">
										<input type="checkbox" name="IsActive" id="IsActive" class="form-check-input"
											   value="true" checked="checked"
											   @(isChecked ? "checked" : "") style="transform: scale(1.3); margin-top: 2px;" />
										<label for="IsActive" class="form-label fw-semibold mb-0 ms-2" style="font-size: 16px;">Is Active</label>
									</div>

									<!-- Buttons -->
									<div class="col-12">
										<div class="button-main d-flex gap-2 mt-3">
											<button type="submit" class="card-link">
												<i class="ri-save-line"></i><span>Save</span>
											</button>
											@if (Model.CompanyId == 0 || Model.CompanyId == null)
											{
												<button type="reset" class="card-link outline-bar">
													<span>Clear</span>
												</button>
											}
											<a href="@Url.Action("CompanyMasterList", "CompanyMaster")" class="card-link outline-bar">
												<span>View</span>
											</a>
										</div>
									</div>

								</form>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</body>
</html>

