@{
    ViewData["Title"] = "QR Code Demo";
}

<h2>Generate QR Code</h2>
<form asp-action="GenerateAndSave" asp-controller="QrCode" method="post">
    <input type="text" name="text" placeholder="Enter text" required />
    <button type="submit">Generate</button>
</form>

@if (ViewBag.QrImageUrl != null)
{
    <h3>Your QR Code:</h3>
    <img src="@ViewBag.QrImageUrl" width="200" height="200" />
}

<hr />

<h2>Scan QR Code</h2>
<form asp-action="Scan" asp-controller="QrCode" method="post" enctype="multipart/form-data">
    <input type="file" name="file" accept="image/*" required />
    <button type="submit">Scan</button>
</form>

@if (ViewBag.ScanResult != null)
{
    <h3>Scan Result:</h3>
    <p>@ViewBag.ScanResult</p>
}

