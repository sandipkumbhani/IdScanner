@model SocPass.Domain.Model.Society
@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	string userRole = ViewBag.UserRole as string ?? "";
	bool isAdmin = string.Equals(userRole, "Admin", StringComparison.OrdinalIgnoreCase);
	bool isNew = Model.SocietyId == 0;
	bool isChecked = Model.IsActive || (isAdmin && isNew);
	string Title = ViewBag.Title;
}
<html>
<head>
	<title>SocPass | @Title Society</title>
	<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
	<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</head>
<body>
	<div class="content-page">
		<div class="content">
			<div class="main-inner container-fluid">
				<div class="row">
					<div class="col-12">
						<div class="card com-profile-info">
							<div class="top-details">
								<h2 class="page-form-title">Society Details</h2>
							
								<form asp-action="AddSociety" asp-controller="Society" method="post" enctype="multipart/form-data" class="row all-custom-class">
									@* Hidden primary key *@
									<input type="hidden" asp-for="SocietyId" />

									<div class="col-md-6 mb-3">
										<div class="item-input">
											<label asp-for="Name" class="form-label required fw-semibold fs-6"></label>
											<input asp-for="Name" class="form-control userinput" />
											<span asp-validation-for="Name" class="text-danger"></span>
										</div>
									</div>

									<div class="col-md-6 mb-3">
										<div class="item-input">
											<label asp-for="Email" class="form-label required fw-semibold fs-6"></label>
											<input asp-for="Email" class="form-control userinput" />
											<span asp-validation-for="Email" class="text-danger"></span>
										</div>
									</div>

									<div class="col-md-6 mb-3">
										<div class="item-input">
											<label asp-for="Address" class="form-label required fw-semibold fs-6"></label>
											<textarea asp-for="Address" class="form-control userinput" rows="3"></textarea>
											<span asp-validation-for="Address" class="text-danger"></span>
										</div>
									</div>

									<div class="col-md-6 mb-3">
										<div class="item-input">
											<label asp-for="Contact" class="form-label required fw-semibold fs-6"></label>
											<input asp-for="Contact" class="form-control userinput" />
											<span asp-validation-for="Contact" class="text-danger"></span>
										</div>
									</div>

									<div class="col-md-6 mb-3">
										<div class="item-input">
											<label asp-for="Contact2" class="form-label required fw-semibold fs-6"></label>
											<input asp-for="Contact2" class="form-control userinput" />
											<span asp-validation-for="Contact2" class="text-danger"></span>
										</div>
									</div>

									<div class="col-md-6 mb-3 d-flex align-items-center">
										<input asp-for="IsActive" class="form-check-input" checked style="transform: scale(1.3); margin-top: 2px;" />
										<label asp-for="IsActive" class="form-label fw-semibold mb-0 ms-2" style="font-size: 16px;"></label>
									</div>

									<div class="col-12">
										<div class="button-main d-flex gap-2 mt-3">
											<button type="submit" class="card-link">
												<i class="ri-save-line"></i><span>Save</span>
											</button>
											@if (Model.SocietyId == 0)
											{
												<button type="reset" class="card-link outline-bar">
													<span>Clear</span>
												</button>
											}
											<a asp-action="SocietyList" asp-controller="Society" class="card-link outline-bar">
												<span>View</span>
											</a>
										</div>
									</div>
								</form>

							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</body>
</html>

