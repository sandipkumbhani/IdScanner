@model SocPass.Domain.Model.Block
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isNew = Model.BlockId == 0;
}
<html>
<head>
    <title>SocPass | Add Block</title>
</head>
    <body>
<div class="content-page">
    <div class="content">
        <div class="main-inner container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card com-profile-info">
                        <div class="top-details">
                            <h2 class="page-form-title">Add Block Details</h2>
                            <form asp-action="AddBlock" asp-controller="Block" method="post" class="row all-custom-class">

                                <input type="hidden" asp-for="BlockId" />
                                    @if (ViewBag.ErrorMessage != null)
                                    {
                <div class="text-danger">@ViewBag.ErrorMessage</div>
                                    }

                                    @if (ViewBag.BlockNumberMsg != null)
                                    {
            <div class="alert alert-warning">@ViewBag.BlockNumberMsg</div>
                                    }
                                <div class="col-xl-4 col-lg-6">
                                    <div class="item-input">
                                        <label asp-for="SocietyId" class="form-label required fw-semibold fs-6"></label>
                                        @* <select asp-for="SocietyId" asp-items="@(new SelectList(ViewBag.SocietyList, "SocietyId", "Name"))" class="form-control userinput"> *@

                                            <select asp-for="SocietyId" asp-items="@(ViewBag.SocietyList)" class="form-control userinput" disabled="@(ViewBag.IsSocietyReadonly ? "disabled" : null)">

                                            <option value="">-- Select Society --</option>
                                        </select>
                                            <input type="hidden" asp-for="SocietyId" />
                                        <span asp-validation-for="SocietyId" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="col-xl-4 col-lg-6">
                                    <div class="item-input">
                                        <label asp-for="BlockNumber" class="form-label required fw-semibold fs-6"></label>
                                        <input asp-for="BlockNumber" class="form-control userinput" />
                                        <span asp-validation-for="BlockNumber" class="text-danger"></span>
                                    </div>
                                </div>

                                  <div   class="button-main" style="display: flex; gap: 12px; margin-top: 20px;">
                                        <button type="submit" class="card-link">
                                            <span>Save</span>
                                        </button>
                                    @if (isNew)
                                    {
                                        <button type="reset" class="card-link outline-bar">Clear</button>
                                    }
                                    <a asp-action="BlockList" asp-controller="Block" class="card-link outline-bar">View</a>
                                </div>

                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>

