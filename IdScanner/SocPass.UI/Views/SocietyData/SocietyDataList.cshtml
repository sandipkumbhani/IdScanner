
@model IEnumerable<SocPass.Domain.Model.SocietyData>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var societyDataList = Model;
}
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link href="~/css/stylesheet.css" rel="stylesheet" />
    <link href="~/css/addpagination.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/bootstrap.rtl.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/bootstrap.css" rel="stylesheet" />
    <link href="~/wwwroot/lib/bootstrap/css/bootstrap.css" rel="stylesheet" />
    <link href="~/wwwroot/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/app-style.css" rel="stylesheet" />
    <link rel="StyleSheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <title>SocPass | SocietyDataList</title>
</head>
<body>
    <div class="content-page">
        <div class="content">
            <div class="main-inner container-fluid">
                <div class="row">
                    <div class="col-12 mb-3">
                        <div class="page-title-box add d-flex justify-content-between align-items-center">
                            <h1 class="page-title">Society Data Master</h1>
                            <div class="add-btn">
                                <a href="#" id="btnAddSocietyData">
                                    <i class="ri-add-line"></i> <span>Add Society Data</span>
                                </a>
                            </div>

                        </div>
                    </div>

                    <div class="col-12">
                        <div class="card com-profile-info">
                            <div class="table-top-header">
                                <h4>List of Society Data</h4>
                            </div>

                            <div class="table-responsive">
                                <table id="franchiseTable" class="table dt-responsive nowrap w-100">
                                    <thead>
                                        <tr>
                                            <th class="dt-orderable-asc dt-orderable-desc">Society</th>
                                            <th>Block</th>
                                            <th>Flat</th>
                                            <th>Contact Name</th>
                                            <th>Contact Number</th>
                                            <th>Contact Email</th>
                                            <th>IsActive</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var societyData in societyDataList)
                                        {
                                            <tr>
                                                <td>@societyData.Flat?.Block?.Society?.Name</td>
                                                <td>@societyData.Flat?.Block?.BlockNumber</td>
                                                <td>@societyData.Flat?.FlatNumber</td>
                                                <td>@societyData.ContactName</td>
                                                <td>@societyData.ContactNumber</td>
                                                <td>@societyData.ContactEmail</td>
                                                <td>@(societyData.IsActive ? "Yes" : "No")</td>
                                                <td>
                                                    <div class="action-items">
                                                        <a href="@Url.Action("EditSocietyData", "SocietyData", new { id = societyData.SocietyDataId })" class="icon-btn">
                                                            <i class="ri-edit-2-line"></i>
                                                        </a>
                                                        <a href="@Url.Action("DeleteSocietyData", "SocietyData", new { id = societyData.SocietyDataId })" class="icon-btn"
                                                           onclick="return confirm('are you sure you want to delete this menu?');">
                                                            <i class="ri-delete-bin-3-line"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                                
                                <div class="datatable-footer-bottom">
                                    <div class="totle-left">
                                        <span id="totalRecords">Total Reminders: 3</span>
                                    </div>
                                    <div id="pagination" class="dataTables_paginate paging_simple_numbers"></div>
                                    <div class="show-page">
                                        <span>Show per page:</span>
                                        <select id="rowsPerPage" class="form-select">
                                            <option value="5">5 </option>
                                            <option value="10" selected>10 </option>
                                            <option value="25">25</option>
                                        </select>
                                    </div>
                                </div>
                            </div> 
                        </div> 
                    </div> 
                </div> 
            </div> 
        </div> 
    </div> 

    <script type="text/javascript">
        $(document).on("click", "#btnAddSocietyData", function () {
            window.location.href = "/SocietyData/AddSocietyData";
        });
    </script>
</body>
</html>
<script src="~/js/addpagination.js"></script>

