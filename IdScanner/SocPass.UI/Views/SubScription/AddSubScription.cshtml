@model SocPass.Domain.Model.Subscription
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<title>SocPass | Add Subscription</title>

<div class="content-page">
    <div class="content">
        <div class="main-inner container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="page-title-box">
                        <h1 class="page-title">Add Subscription</h1>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <div class="card com-profile-info">
                        <div class="top-details">
                            <h2 class="page-form-title">Add Subscription</h2>

                            <form class="row all-custom-class" method="post"
                                  action="@Url.Action("AddSubScription", "Subscription")">
                                <input type="hidden" name="SubscriptionId" value="@Model.SubscriptionId" />

                                <!-- Society Dropdown -->
                                <div class="col-xl-4 col-lg-6 mb-3">
                                    <div class="item-input">
                                        <label asp-for="SocietyId" class="form-label required fw-semibold fs-6"></label>
                                        <select asp-for="SocietyId"
                                                asp-items="@(new SelectList(ViewBag.SocietyList ?? new List<SocPass.Domain.Model.Society>(), "SocietyId", "Name", Model?.SocietyId))"
                                                class="form-control userinput">
                                            <option value="">-- Select Society --</option>
                                        </select>
                                        @* Display server-side validation error *@
                                        <span class="text-danger">
                                            @Html.ValidationMessageFor(m => m.SocietyId)
                                        </span>
                                    </div>
                                </div>

                                <!-- Start From -->
                                <div class="col-xl-4 col-lg-6 mb-3">
                                    <div class="item-input">
                                        <label for="StartFrom" class="form-label required fw-semibold fs-6">Start From</label>
                                        <input type="date" class="form-control userinput"
                                               id="StartFrom" name="StartFrom"
                                               value="@(Model?.StartFrom != null ? Model.StartFrom.ToString("yyyy-MM-dd") : DateTime.Now.ToString("yyyy-MM-dd"))"
                                               min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                        <span class="text-danger">
                                            @Html.ValidationMessageFor(m => m.StartFrom)
                                        </span>
                                    </div>
                                </div>

                                <!-- End To -->
                                <div class="col-xl-4 col-lg-6 mb-3">
                                    <div class="item-input">
                                        <label for="EndTo" class="form-label required fw-semibold fs-6">End To</label>
                                        <input type="date" class="form-control userinput"
                                               id="EndTo" name="EndTo"
                                               value="@(Model?.EndTo != null ? Model.EndTo.ToString("yyyy-MM-dd") : DateTime.Now.ToString("yyyy-MM-dd"))"
                                               min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                        <span class="text-danger">
                                            @Html.ValidationMessageFor(m => m.EndTo)
                                        </span>
                                    </div>
                                </div>

                                <!-- Buttons -->
                                <div class="button-main d-flex gap-3 mt-4">
                                    <button type="submit" class="card-link">
                                        <i class="ri-save-line"></i> <span>Save</span>
                                    </button>

                                    @if (Model.SubscriptionId == 0 || Model.SubscriptionId == null)
                                    {
                                        <button type="reset" class="card-link outline-bar">
                                            <i class="ri-refresh-line"></i> <span>Clear</span>
                                        </button>
                                    }

                                    <a href="@Url.Action("SubScriptionList", "Subscription")" class="card-link outline-bar">
                                        <i class="bi bi-eye"></i> <span>View</span>
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>









