@model SocPass.Domain.Model.Flat
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    IList<SocPass.Domain.Model.Flat> FlatList = ViewBag.FlatList;
    var isAdmin = (bool)(ViewBag.IsAdmin ?? false);
    var userSocietyName = ViewBag.UserSocietyName ?? "";
}
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link href="~/css/stylesheet.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/bootstrap.rtl.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/bootstrap.css" rel="stylesheet" />
    <link href="~/wwwroot/lib/bootstrap/css/bootstrap.css" rel="stylesheet" />
    <link href="~/wwwroot/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/app-style.css" rel="stylesheet" />
    <link rel="StyleSheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <title>SocPass | FlatsList</title>
    <style>
        /* Pagination container */
        .dataTables_paginate {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            margin-top: 15px;
        }

            .dataTables_paginate a,
            .dataTables_paginate button {
                min-width: 40px;
                height: 40px;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 0 12px;
                font-size: 16px;
                border-radius: 10px;
                background: white;
                color: #000;
                cursor: pointer;
                text-decoration: none;
                transition: all 0.2s ease;
                border: none;
            }

                /* Hover */
                .dataTables_paginate a:hover,
                .dataTables_paginate button:hover {
                    background: #f0f0f0;
                }

            /* Active page (match Add Block button) */
            .dataTables_paginate .current,
            .dataTables_paginate .page-number.active {
                background-color: #0466C8; /* Replace with your actual Add Block button bg color */
                color: #fff !important;
                font-weight: 600;
                border: none;
                box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
            }

            /* Disabled */
            .dataTables_paginate .disabled,
            .dataTables_paginate button:disabled {
                opacity: 0.5;
                cursor: not-allowed;
            }

            /* Previous / Next */
            .dataTables_paginate .previous a,
            .dataTables_paginate .next a {
                font-size: 16px;
                font-weight: 500;
                border-radius: 10px;
            }
    </style>
</head>
<body>
    <div class="content-page" style="margin:35px 0 0 0">
        <div class="content">
            <div class="main-inner container-fluid">
                <div class="row">
                    <!-- Month Filter Dropdown (styled exactly like screenshot) -->
                    <div class="col-12 mb-3">
                        <div class="col-12">
                            <div class="page-title-box add">
                                <h1 class="page-title">Flats</h1>

                                <div class="add-btn">
                                    <a href="#" id="btnAddFlat">
                                        <i class="ri-add-line"></i> <span>Add Flats</span>
                                    </a>
                                    <br/>
                                    @* <a href="@Url.Action("AddMember", "Member")">
                                      <i class="ri-add-line"></i> <span>Add Member</span>
                                    </a> *@
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="card com-profile-info">
                            <!-- Top Header -->
                            <div class="table-top-header">
                                <h4>List of Flats</h4>
                                <div class="d-flex gap-2">
                                    @*  <div class="table-search-box">
                                    <input type="text" id="customFranchiseSearch" class="form-control form-control-sm" placeholder="Search...">
                                    <button type="submit"><i class="ri-search-line"></i></button>
                                </div> *@
                                    @*  <div id="exportFranchiseButtons">
                                    <button id="exportExcel" class="btn-btn-outline-secondary">
                                        <i class="bi bi-file-earmark-excel"></i> Export
                                    </button>
                                </div> *@
                                </div>
                            </div>
                            <!-- Table -->
                            <div class="table-responsive">
                                <table id="franchiseTable" class="table dt-responsive nowrap w-100">
                                    <thead>
                                        <tr>
                                            <th class="dt-orderable-asc dt-orderable-desc">Society Name</th>
                                            <th>Block No.</th>
                                            <th>Floor No.</th>
                                            <th>Flat No.</th>
                                            <th>Total Member</th>
                                            <th>Number Of Adult</th>
                                            <th>Number Of Child</th>
                                            <th>IsActive</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var flat in FlatList)
                                        {
                                            <tr>
                                                <td>@flat.Society.Name</td>
                                                <td>@flat.Block.BlockNumber</td>
                                                <td>@flat.FloorNumber</td>
                                                <td>@flat.FlatNumber</td>
                                                <td>@flat.TotalMember</td>
												<td>@flat.NumberOfAdult</td>
												<td>@flat.NumberOfChild</td>
                                                <td>@flat.IsActive</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <!-- Bottom Area -->
                                <div class="datatable-footer-bottom">
                                    <div class="totle-left">
                                        <span id="totalRecords">Total Reminders: 3</span>
                                    </div>
                                    <div id="pagination" class="dataTables_paginate paging_simple_numbers"></div>
                                    <div class="show-page">
                                        <span>Show per page:</span>
                                        <select id="rowsPerPage" class="form-select">
                                            <option value="5">5 </option>
                                            <option value="10" selected>10 </option>
                                            <option value="25">25</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script type="text/javascript">

         $(document).ready(function () {
            var isAdmin = @isAdmin.ToString().ToLower();
            var userSocietyName = "@userSocietyName";

            // Filter rows for non-admin users
            if (!isAdmin && userSocietyName) {
                $('#franchiseTable tbody tr').each(function () {
                    var societyName = $(this).find('td:eq(0)').text().trim();
                    if (societyName !== userSocietyName) {
                        $(this).addClass("society-hidden").hide(); // mark filtered rows
                    }
                });
            }

        $(document).on("click", "#btnAddFlat", AddFlat);

        function AddFlat(){
           window.location.href = "/Flat/AddFlat";
         };

           function getFilteredRows() {
                return $('#franchiseTable tbody tr').not(".society-hidden");
            }

            function updateTotalRecords() {
                var totalFilteredRows = getFilteredRows().length;
                $('#totalRecords').text('Total Reminders: ' + totalFilteredRows);
            }

            // Show a specific page
            var currentPage = 1;
            function showPage(page, rowsPerPage, $rows) {
                $rows.hide();
                var start = (page - 1) * rowsPerPage;
                $rows.slice(start, start + rowsPerPage).show();

                currentPage = page;
                updateTotalRecords(); // ✅ always show correct total
            }

            // Pagination function
            function paginateTable() {
                var rowsPerPage = parseInt($('#rowsPerPage').val());
                var $rows = getFilteredRows();

                var totalRows = $rows.length;
                var totalPages = Math.ceil(totalRows / rowsPerPage);
                var $pagination = $('#pagination');

                $pagination.empty();

                // Left arrow
                if (totalPages > 1) {
                    $pagination.append('<a href="#" class="page-link page-prev">&lt;</a>');
                }

                // Numbered pages
                for (var i = 1; i <= totalPages; i++) {
                    $pagination.append('<a href="#" class="page-link page-number" data-page="' + i + '">' + i + '</a>');
                }

                // Right arrow
                if (totalPages > 1) {
                    $pagination.append('<a href="#" class="page-link page-next">&gt;</a>');
                }

                showPage(currentPage, rowsPerPage, $rows);
                highlightCurrentPage();

                // Click events
                $pagination.off('click').on('click', '.page-link', function (e) {
                    e.preventDefault();
                    if ($(this).hasClass('page-prev')) {
                        if (currentPage > 1) currentPage--;
                    } else if ($(this).hasClass('page-next')) {
                        if (currentPage < totalPages) currentPage++;
                    } else {
                        currentPage = parseInt($(this).data('page'));
                    }
                    showPage(currentPage, rowsPerPage, $rows);
                    highlightCurrentPage();
                });

                function highlightCurrentPage() {
                    $pagination.find('.page-number').removeClass('active');
                    $pagination.find('.page-number[data-page="' + currentPage + '"]').addClass('active');
                }

                // ✅ Always update once on init
                updateTotalRecords();
            }

            // Initialize pagination
            paginateTable();
            $('#rowsPerPage').change(function () {
                currentPage = 1;
                paginateTable();
            });
        });
    </script>
</body>
</html>


