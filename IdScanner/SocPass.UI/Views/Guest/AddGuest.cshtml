@model SocPass.UI.Domain.Model.MemberCreateRequest
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="content-page">
    <div class="content">
        <div class="main-inner container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="page-title-box">
                        <h1 class="page-title">Add Block</h1>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="card com-profile-info">
                        <iv class="top-details">
                            <h2 class="page-form-title">Add Block Details</h2>
                            <form method="post" action="@Url.Action("AddGuest", "Member")">
                                <div class="col-xl-4 col-lg-6">
                                    <div class="item-input">
                                        <label for="" class="form-label required fw-semibold fs-6">Select Society</label>
                                        <select id="Society" name="SocietyId" class="form-select">
                                            <option value="">-- Select Society --</option>
                                            @if (ViewBag.Societies != null)
                                            {
                                                foreach (var society in ViewBag.Societies)
                                                {
                                                    <option value="@society.SocietyId">@society.Name</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xl-4 col-lg-6">
                                    <div class="item-input">
                                        <label for="" class="form-label required fw-semibold fs-6">Select Block</label>
                                        <select id="Block" name="BlockId" class="form-select">
                                            <option value="">-- Select Block --</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="row mt-3">
                                    <div class="col-md-4">
                                        <label class="form-label fw-semibold">Select Flat</label>
                                        <select id="Flat" name="FlatId" class="form-select w-100">
                                            <option value="">-- Select Flat --</option>
                                        </select>
                                    </div>
                                </div>

                                <div id="flatInputsContainer" class="mt-3"></div>
                                @* <div class="mt-4 d-flex gap-2">
                                    <button type="submit" class="btn btn-success">
                                        <i class="ri-save-line"></i> Save
                                    </button>
                                    <button type="reset" class="btn btn-outline-secondary">Clear</button>
                                </div> *@
                            </form>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $("#Society").change(function () {
            var societyId = $(this).val();
            $("#Block").empty().append('<option value="">-- Select Block --</option>');
            $("#Flat").empty().append('<option value="">-- Select Flat --</option>');
            $("#flatInputsContainer").empty();

            if (societyId) {
                $.getJSON('@Url.Action("GetBlocksBySociety", "Member")', { societyId: societyId }, function (data) {
                    $.each(data, function (i, block) {
                        $("#Block").append($('<option>', { value: block.blockId, text: block.blockName }));
                    });
                });
            }
        });
        $("#Block").change(function () {
            var blockId = $(this).val();
            $("#Flat").empty().append('<option value="">-- Select Flat --</option>');
            $("#flatInputsContainer").empty();

            if (blockId) {
                $.getJSON('@Url.Action("GetFlatsByBlock", "Member")', { blockId: blockId }, function (data) {
                    $.each(data, function (i, flat) {
                        $("#Flat").append($('<option>', { value: flat.flatId, text: flat.flatNumber }));
                    });
                });
            }
        });
        $("#Flat").change(function () {
            var flatId = $(this).val();
            var flatName = $("#Flat option:selected").text();
            var container = $("#flatInputsContainer");
            container.empty();

            if (!flatId) return;

            var row = $(`
                    <div class="card mb-3 p-3 border">
                        <h5 class="mb-3">Flat ${flatName}</h5>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label>Adults</label>
                                <input type="number" class="form-control adults" min="0" placeholder="Adults" />
                            </div>
                            <div class="col-md-3">
                                <label>Children</label>
                                <input type="number" class="form-control flatChildren"
                                       data-flatid="${flatId}" min="0" placeholder="Children" />
                            </div>
                            <!-- child ages will appear below -->
                            <div class="col-md-12 mt-2 childAgesContainer"></div>

                            <div class="col-md-12 text-end mt-3">
                                <button type="button" class="btn btn-primary saveFlatBtn" data-flatid="${flatId}">
                                    Save Flat
                                </button>
                            </div>
                        </div>
                    </div>
                `);

            container.append(row);

            row.find(".flatChildren").on("input change", function () {
                var childCount = parseInt($(this).val()) || 0;
                var agesContainer = $(this).closest(".card").find(".childAgesContainer");
                agesContainer.empty();

                for (var i = 0; i < childCount; i++) {
                    agesContainer.append(`
                            <div class="col-md-3 mb-2">
                                <input type="number"
                                       name="ChildAges[${flatId}][${i}]"
                                       class="form-control"
                                       min="0" max="17"
                                       placeholder="Child ${i + 1} Age" />
                            </div>
                        `);
                }
            });
        });
        $("#flatInputsContainer").on("click", ".saveFlatBtn", function () {
            var flatId = $(this).data("flatid");
            var row = $(this).closest(".card");
            var adults = parseInt(row.find(".adults").val() || 0);
            var childAges = [];

            row.find(".childAgesContainer input").each(function () {
                var age = parseInt($(this).val());
                if (!isNaN(age)) childAges.push(age);
            });

            var memberCreateRequest = { FlatId: flatId, NumberOfAdults: adults, ChildAges: childAges };

            $.ajax({
                url: '@Url.Action("AddGuest", "Member")',
                type: 'POST',
                data: JSON.stringify(memberCreateRequest),
                contentType: 'application/json; charset=utf-8',
                success: function () {
                    alert("Flat " + flatId + " saved successfully!");
                    row.find(".adults, .flatChildren").val('');
                    row.find(".childAgesContainer").empty();
                },
                error: function () { alert("Error saving Flat " + flatId); }
            });
        });
    });
</script>