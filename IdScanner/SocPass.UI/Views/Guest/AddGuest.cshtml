@model SocPass.UI.Domain.Model.MemberCreateRequest
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<title>SocPass | Add Guest</title>

<div class="content-page">
    <div class="content">
        <div class="main-inner container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="page-title-box">
                        <h1 class="page-title">Add Guest</h1>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12">
                    <div class="card com-profile-info">
                        <div class="top-details">
                            <h2 class="page-form-title">Add Guest Details</h2>

                            <form id="guestForm">
                                <div class="row g-3 align-items-end">
                                    <!-- Society -->
                                    <div class="col-md-4">
                                        <label class="form-label">Select Society</label>
                                        <select id="Society" class="form-select">
                                            <option value="">-- Select Society --</option>
                                            @if (ViewBag.Societies != null)
                                            {
                                                foreach (var society in ViewBag.Societies)
                                                {
                                                    <option value="@society.SocietyId">@society.Name</option>
                                                }
                                            }
                                        </select>
                                        <span class="text-danger small" id="societyError"></span>
                                    </div>

                                    <!-- Block -->
                                    <div class="col-md-4">
                                        <label class="form-label">Select Block</label>
                                        <select id="Block" class="form-select">
                                            <option value="">-- Select Block --</option>
                                        </select>
                                        <span class="text-danger small" id="blockError"></span>
                                    </div>

                                    <!-- Flat -->
                                    <div class="col-md-4">
                                        <label class="form-label">Select Flat</label>
                                        <select id="Flat" class="form-select">
                                            <option value="">-- Select Flat --</option>
                                        </select>
                                        <span class="text-danger small" id="flatError"></span>
                                    </div>
                                </div>

                                <!-- Dynamic Inputs -->
                                <div id="flatInputsContainer" class="mt-3"></div>

                                <!-- Buttons -->
                                <div class="col-12 mt-3 d-flex gap-2">
                                    <button type="button" id="saveFlatBtnGlobal" class="btn btn-primary">
                                        <i class="ri-save-line"></i> Save
                                    </button>
                                    <button type="reset" id="clearBtn" class="btn btn-outline-secondary">Clear</button>
                                    <a href="@Url.Action("FlatList", "Flat")" class="btn btn-outline-dark">View</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .dynamicRow .form-control {
        width: 100%;
    }

    .childAgesContainer input {
        width: 100%;
    }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        // Validate dropdowns
        function validateDropdowns() {
            let valid = true;
            if ($("#Society").val() === "") { $("#societyError").text("Please select a society."); valid = false; } else { $("#societyError").text(""); }
            if ($("#Block").val() === "") { $("#blockError").text("Please select a block."); valid = false; } else { $("#blockError").text(""); }
            if ($("#Flat").val() === "") { $("#flatError").text("Please select a flat."); valid = false; } else { $("#flatError").text(""); }
            return valid;
        }
        // Validate dynamic row
        function validateDynamicRow(row) {
            let valid = true;
            // Adults
            var adults = row.find(".adults").val();
            if (adults === "" || parseInt(adults) < 0) {
                row.find(".adults").addClass("is-invalid");
                row.find(".adultError").text("Please enter number of adults").show();
                valid = false;
            } else {
                row.find(".adults").removeClass("is-invalid");
                row.find(".adultError").hide();
            }
            // Children
            var children = row.find(".flatChildren").val();
            if (children === "" || parseInt(children) < 0) {
                row.find(".flatChildren").addClass("is-invalid");
                row.find(".childrenError").text("Please enter number of children").show();
                valid = false;
            } else {
                row.find(".flatChildren").removeClass("is-invalid");
                row.find(".childrenError").hide();
            }
            // Child Ages
            row.find(".childAgesContainer input").each(function () {
                var age = $(this).val();
                var errorSpan = $(this).next(".childAgeError");
                if (age === "" || parseInt(age) < 0 || parseInt(age) > 17) {
                    $(this).addClass("is-invalid");
                    errorSpan.text("Enter valid age (0–17)").show();
                    valid = false;
                } else {
                    $(this).removeClass("is-invalid");
                    errorSpan.hide();
                }
            });
            return valid;
        }
        $("#Society").change(function () {
            var societyId = $(this).val();
            $("#Block").empty().append('<option value="">-- Select Block --</option>');
            $("#Flat").empty().append('<option value="">-- Select Flat --</option>');
            $("#flatInputsContainer").empty();
            if (!societyId) return;
            $.getJSON('@Url.Action("GetBlocksBySociety", "Member")', { societyId }, function (data) {
                $.each(data, function (i, b) { $("#Block").append($('<option>', { value: b.blockId, text: b.blockName })); });
            });
        });
        // Load flats
        $("#Block").change(function () {
            var blockId = $(this).val();
            $("#Flat").empty().append('<option value="">-- Select Flat --</option>');
            $("#flatInputsContainer").empty();
            if (!blockId) return;
            $.getJSON('@Url.Action("GetFlatsByBlock", "Member")', { blockId }, function (data) {
                $.each(data, function (i, f) { $("#Flat").append($('<option>', { value: f.flatId, text: f.flatNumber })); });
            });
        });
        // Generate dynamic row on flat selection
        $("#Flat").change(function () {
            var flatId = $(this).val();
            if (!flatId) return;
            var container = $("#flatInputsContainer");
            container.empty();
            var row = $(`
                        <div class="dynamicRow row border p-2 rounded mb-2">
                            <!-- Adults -->
                            <div class="col-md-4">
                                <label>Adults</label>
                                <input type="number" class="form-control adults" min="0" placeholder="Adults">
                                <span class="text-danger small mt-1 adultError" style="display:none;"></span>
                            </div>
                            <!-- Children -->
                            <div class="col-md-4">
                                <label>Children</label>
                                <input type="number" class="form-control flatChildren" min="0" placeholder="Children">
                                <span class="text-danger small mt-1 childrenError" style="display:none;"></span>
                            </div>
                            <!-- Child Ages -->
                            <div class="col-md-4">
                                <label class="childAgeLabel" style="display:none;">Child Ages</label>
                                <div class="childAgesContainer d-flex flex-column gap-2"></div>
                            </div>
                        </div>
                    `);
            container.append(row);
            // Generate child age inputs
            row.find(".flatChildren").on("input change", function () {
                var childCount = parseInt($(this).val()) || 0;
                var ageContainer = $(this).closest(".dynamicRow").find(".childAgesContainer");
                var ageLabel = $(this).closest(".dynamicRow").find(".childAgeLabel");
                ageContainer.empty();
                if (childCount > 0) ageLabel.show();
                else ageLabel.hide();
                for (var i = 0; i < childCount; i++) {
                    ageContainer.append(`
                                <div>
                                    <input type="number" class="form-control childAge" min="0" max="17" placeholder="Child ${i + 1} Age">
                                    <span class="text-danger small mt-1 childAgeError" style="display:none;"></span>
                                </div>
                            `);
                }
            });
        });
        // Save Flat button
        $("#saveFlatBtnGlobal").click(function () {
            var row = $("#flatInputsContainer .dynamicRow");
            if (!validateDropdowns() || !validateDynamicRow(row)) return;
            var flatId = $("#Flat").val();
            var adults = parseInt(row.find(".adults").val() || 0);
            var childAges = [];
            row.find(".childAge").each(function () { childAges.push(parseInt($(this).val())); });
            $.ajax({
                url: '@Url.Action("AddGuest", "Member")',
                type: 'POST',
                data: JSON.stringify({ FlatId: flatId, NumberOfAdults: adults, ChildAges: childAges }),
                contentType: 'application/json; charset=utf-8',
                success: function () {
                    alert("Saved successfully!");
                    row.find("input").val('');
                    row.find(".childAgesContainer").empty();
                    row.find(".childAgeLabel").hide();
                },
                error: function () { alert("Error saving"); }
            });
        });
        // Clear
        $("#clearBtn").click(function () {
            $("#Society,#Block,#Flat").val('').trigger('change');
            $("#flatInputsContainer").empty();
        });
    });
</script>

