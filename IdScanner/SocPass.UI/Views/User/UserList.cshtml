@model MicroService_Template.Domain.Model.ModelUsers
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    IList<MicroService_Template.Domain.Model.ModelUsers> UserList = ViewBag.UserList;
}
<html>
<head>
    <link href="~/css/addpagination.css" rel="stylesheet" />
    <link href="~/css/app-style.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <title>Users</title>
</head>
<body>
    <div class="content-page" style="margin:35px 0 0 0">
        <div class="content">
            <div class="main-inner container-fluid">
                <div class="row">
                    <div class="col-12 mb-3">
                        <div class="col-12">
                            <div class="page-title-box add">
                                <h1 class="page-title">Users</h1>
                                <div class="add-btn">
                                    <a href="#" id="btnAddUser">
                                        <i class="ri-add-line"></i> <span>Add User</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                       
                        @* <button class="btn btn-primary me-2" style="width:95px;height:38px;" id="btnAddUser">Add User</button> *@
                        @*  <div class="dropdown">
                        <button id="filterDropdown"
                                class="btn btn-outline-secondary dropdown-toggle month-filter"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            -- All Months -- <i class="ri-arrow-down-s-fill" style="font-size:larger"></i>
                        </button>
                        <ul class="dropdown-menu" id="monthDropdownMenu" aria-labelledby="filterDropdown"></ul>
                    </div> *@
                    </div>
                    <div class="col-12">
                        <div class="card com-profile-info">
                            <!-- Top Header -->
                            <div class="table-top-header">
                                <h4>List of Users</h4>
                                <div class="d-flex gap-2">
                                    @*  <div class="table-search-box">
                                    <input type="text" id="customFranchiseSearch" class="form-control form-control-sm" placeholder="Search...">
                                    <button type="submit"><i class="ri-search-line"></i></button>
                                </div> *@
                                    @*  <div id="exportFranchiseButtons">
                                    <button id="exportExcel" class="btn-btn-outline-secondary">
                                        <i class="bi bi-file-earmark-excel"></i> Export
                                    </button>
                                </div> *@
                                </div>
                            </div>
                            <!-- Table -->
                            <div class="table-responsive" id="franchiseTable">
                                <table id="franchiseTable" class="table dt-responsive nowrap">
                                    <thead>
                                        <tr>
                                            <th class="dt-orderable-asc dt-orderable-desc">Name</th>
                                            <th>Email</th>
                                            <th>User Role</th>
                                            <th>Active</th>
                                            <td>Action</td>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var user in UserList)
                                        {
                                            <tr>
                                                <td>@user.Name</td>
                                                <td>@user.EmailId</td>
                                                <td>@user.UserRole?.Name</td>
                                                <td>@user.IsActive</td>
                                                <td>
                                                    <div class="action-items">
                                                        <a href="@Url.Action("AddUser", "User", new { id = user.UserId })" class="icon-btn">
                                                            <i class="ri-edit-2-line"></i>
                                                        </a>
                                                        <a href="@Url.Action("DeleteUser", "User", new { id = user.UserId })" class="icon-btn"
                                                           onclick="return confirm('Are you sure you want to delete this user?');">
                                                            <i class="ri-delete-bin-3-line"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <div class="datatable-footer-bottom">
                                    <div class="totle-left">
                                        <span id="totalRecords">Total Reminders: 3</span>
                                    </div>
                                    <div id="pagination" class="dataTables_paginate paging_simple_numbers"></div>
                                    <div class="show-page">
                                        <span>Show per page:</span>
                                        <select id="rowsPerPage" class="form-select">
                                            <option value="5" >5 </option>
                                            <option value="10" selected>10 </option>
                                            <option value="25">25</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
<script type="text/javascript">
    $(document).on("click", "#btnAddUser", AddUser);

    function AddUser(){
       window.location.href = "/User/AddUser";
     };
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="~/js/record.js" defer></script>
<script src="~/js/addpagination.js"></script>
