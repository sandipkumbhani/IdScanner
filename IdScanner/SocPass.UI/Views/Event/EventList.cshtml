@model SocPass.Domain.Model.Event
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var EventsList = ViewBag.EventsList as IList<SocPass.Domain.Model.Event> ?? new List<SocPass.Domain.Model.Event>();
}
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link href="~/css/stylesheet.css" rel="stylesheet" />
    @* <link href="~/css/addpagination.css" rel="stylesheet" /> *@
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/app-style.css" rel="stylesheet" />
    <link href="~/css/addpagination.css" rel="stylesheet" />
    <link rel="StyleSheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <title>SocPass | EventList</title>

</head> 
<body>
    <div class="content-page">
        <div class="content">
            <div class="main-inner container-fluid">
                <div class="row">
                    <div class="col-12 mb-3">
                        <div class="col-12">
                            <div class="page-title-box add">
                                <h1 class="page-title">Event</h1>
                                <div class="add-btn">
                                    <a href="#" id="btnAddEvent">
                                        <i class="ri-add-line"></i> <span>Add Event</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="card com-profile-info">
                            <!-- Top Header -->
                            <div class="table-top-header">
                                <h4>List of Event</h4>
                            </div>
                            <!-- Table -->
                            <div class="table-responsive">
                                <table id="eventTable" class="table dt-responsive nowrap w-100">
                                    <thead>
                                        <tr>
                                            <th class="dt-orderable-asc dt-orderable-desc">Event Name</th>
                                            <th>Society Name</th>
                                            <th>Event Venue</th>
                                            <th>Event StartDate</th>
                                            <th>Event EndDate</th>
                                            <th>Start Time</th>
                                            <th>End Time</th>
                                            <th>Organizer</th>
                                            <th>Action</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var events in EventsList)
                                        {
                                            <tr>
                                                <td>@events.EventName</td>
                                                <td>@events.Society.Name</td>
                                                <td>@events.Location</td>
                                                <td>@events.StartDate.ToString("dd-MM-yyyy")</td>
                                                <td>@events.EndDate.ToString("dd-MM-yyyy")</td>
                                                <td>@events.StartTime.ToString(@"hh\:mm")</td>
                                                <td>@events.EndTime.ToString(@"hh\:mm")</td>

                                                <td>@events.Organizer</td>
                                                <td>
                                                    <div class="action-items">
                                                        <a href="@Url.Action("AddEvent", "Event", new { eventId = events.EventId })" class="icon-btn">
                                                            <i class="ri-edit-2-line"></i>
                                                        </a>
                                                        <a href="@Url.Action("DeleteEvent", "Event", new { eventId = events.EventId })" class="icon-btn"
                                                           onclick="return confirm('Are you sure you want to delete this menu?');">
                                                            <i class="ri-delete-bin-3-line"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <!-- Bottom Area -->
                                <div class="datatable-footer-bottom">
                                    <div class="totle-left">
                                        <span id="totalRecords">Total Reminders: 3</span>
                                    </div>
                                    <div id="pagination" class="dataTables_paginate paging_simple_numbers"></div>
                                    <div class="show-page">
                                        <span>Show per page:</span>
                                        <select id="rowsPerPage" class="form-select">
                                            <option value="5">5 </option>
                                            <option value="10" selected>10 </option>
                                            <option value="25">25</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script type="text/javascript">
        $(document).on("click", "#btnAddEvent", AddEvent);

        function AddEvent() {
            window.location.href = "/Event/AddEvent";
        };
    </script>
</body>
</html>
<script src="~/js/addpagination.js"></script>
