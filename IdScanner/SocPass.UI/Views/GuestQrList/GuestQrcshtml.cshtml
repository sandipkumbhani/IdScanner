@model IList<SocPass.Domain.Model.Flat>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>Generated QR Codes</h2>

    @if (Model != null && Model.Any())
    {
        foreach (var flat in Model)
        {
            <div class="mb-4">
                <h5>Flat: @flat.FlatNumber (Total Members: @flat.TotalMember)</h5>
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var member in flat.Members)
                    {
                        <div class="text-center">
                            <img src="@member.QRCodeUrl" style="width:200px; height:200px;" />
                            <div>Member: @member.MemberId</div>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <p>No QR codes found for this block.</p>
    }
</div>
