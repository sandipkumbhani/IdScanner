@model SocPass.Domain.Model.MenuMaster

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    string NameMsg = ViewBag.NameMsg;
    string DescriptionMsg = ViewBag.DescriptionMsg;
    string UrlMsg = ViewBag.UrlMsg;
	string IconMsg = ViewBag.IconMsg;
    string userRole = ViewBag.UserRole as string ?? "";
    bool isAdmin = string.Equals(userRole, "Admin", StringComparison.OrdinalIgnoreCase);
    bool isNew = Model.MenuId == 0;
    bool isChecked = Model.IsDefault || (isAdmin && isNew);
    string Title = ViewBag.Title;
}
<html>
<head>
    <title>SocPass |@Title MenuMaster</title>
</head>
<body>
    <div class="content-page">
        <div class="content">
            <div class="main-inner container-fluid">
                <div class="row">
                    <div class="col-12">
                        <div class="page-title-box">
                            <h1 class="page-title">Add MenuMaster</h1>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <div class="card com-profile-info">
                            <div class="top-details">
                                <h2 class="page-form-title">Menu Details</h2>
                                <form class="row all-custom-class" method="post" action="@Url.Action("AddMenuMaster", "MenuMaster")">
                                    <div class="col-xl-4 col-lg-6">
                                        <div class="item-input">
                                            <input type="text" hidden id="MenuId" name="MenuId" value="@Model.MenuId" />
                                            <label for="name" class="form-label col-form-label required fw-semibold fs-6">Name</label>
                                            <input type="text" class="form-control userinput" id="Name" name="name" value="@Model.Name">
                                            @if (!string.IsNullOrEmpty(NameMsg))
                                            {
                                                <span class="text-danger">@NameMsg</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-xl-4 col-lg-6">
                                        <div class="item-input">
                                            <label for="Description" class="form-label col-form-label required fw-semibold fs-6">Description</label>
                                            <input type="text" class="form-control userinput" id="Description" name="Description" value="@Model.Description">
                                            @if (!string.IsNullOrEmpty(DescriptionMsg))
                                            {
                                                <span class="text-danger">@DescriptionMsg</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-xl-4 col-lg-6">
                                        <div class="item-input">
                                            <label for="Url" class="form-label col-form-label required fw-semibold fs-6">Url</label>
                                            <input type="text" class="form-control userinput" id="Url" name="Url" value="@Model.Url">
                                            @if (!string.IsNullOrEmpty(UrlMsg))
                                            {
                                                <span class="text-danger">@UrlMsg</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="col-xl-4 col-lg-6">
                                        <div class="item-input">
                                            <label for="Icon" class="form-label col-form-label required fw-semibold fs-6">Icon</label>
                                            <input type="text" class="form-control userinput" id="Icon" name="Icon" value="@Model.Icon">
                                            @if (!string.IsNullOrEmpty(IconMsg))
                                            {
                                                <span class="text-danger">@IconMsg</span>
                                            }
                                        </div>
                                    </div>
                                    

                                    <div class="button-main" style="display: flex; gap: 12px; margin-top: 20px;">
                                        <button type="submit" class="card-link">
                                            <i class="ri-save-line"></i>
                                            <span>
                                                Save
                                            </span>
                                        </button>
                                        
                                        @if (Model.MenuId == 0)
										{
                                            <button type="reset" class="card-link outline-bar">
                                            <i class="ri-refresh-line"></i><span>Clear</span>
                                            </button>
                                        }
                                        
                                        <a href="@Url.Action("MenuMasterList", "MenuMaster")" class="card-link outline-bar">
                                        <i class="bi bi-eye"></i><span>View</span>
                                        </a>
                                    </div>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
