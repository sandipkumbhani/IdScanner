@model SocPass.Domain.Model.QRCodeMaster
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Member Details</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .card {
            border: none;
            border-radius: 10px;
            overflow: hidden;
        }

        .card-header {
            background-color: #0466C8;
            color: #fff;
            text-align: center;
            padding: 1rem 0;
            font-size: 1.5rem;
            font-weight: 600;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background-color: #fff;
        }

        th, td {
            padding: 0.75rem 1rem;
            text-align: left;
            vertical-align: middle;
        }

        th {
            background-color: #f2f2f2;
            width: 40%;
            font-weight: 600;
        }

        tr:nth-child(even) td {
            background-color: #fafafa;
        }

        .alert {
            border-radius: 8px;
        }

        .btn-success {
            background-color: #198754;
            border: none;
            border-radius: 6px;
            padding: 10px 30px;
        }

            .btn-success:hover {
                background-color: #157347;
            }

        .container {
            margin-top: 80px;
            max-width: 700px;
        }

        }
    </style>
</head>
<body>

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header">
                Member Details
            </div>

            <div class="card-body">

                @if (!string.IsNullOrEmpty(ViewBag.Message))
                {
                    <div class="alert alert-@ViewBag.AlertType text-center">
                        @ViewBag.Message
                    </div>
                }

                <table class="table table-bordered align-middle mb-4">
                    <tbody>
                        <input type="hidden" asp-for="EventId" />
                        <tr>
                            <th>Society Name</th>
                            <td>@Model.Member.Flat?.Society?.Name</td>
                        </tr>
                        <tr>
                            <th>Block Number</th>
                            <td>@Model.Member.Flat?.Block?.BlockNumber</td>
                        </tr>
                        <tr>
                            <th>Flat Number</th>
                            <td>@Model.Member.Flat?.FlatNumber</td>
                        </tr>
                        <tr>
                            <th>Category</th>
                            <td>@(Model.Member.IsChild ? "Child" : "Adult")</td>
                        </tr>
                        <tr>
                            <th>Member Type</th>
                            <td>@(Model.Member.IsGuest ? "Guest" : "Resident")</td>
                        </tr>
                        <tr>
                            <th>Visited</th>
                            <td>@(Model.Visited ? "Yes" : "No")</td>
                        </tr>
                        <tr>
                            <th>Event Name</th>
                            <td>@Model.Event.EventName</td>
                        </tr>
                    </tbody>
                </table>

                @if (!Model.Visited)
                {
                    <form asp-action="IsVisited"
                          asp-controller="MemberDetails"
                          asp-route-memberId="@Model.MemberId"
                          asp-route-EventId="@Model.EventId"
                          method="post"
                          class="text-center">
                        <button type="submit" class="btn btn-success btn-lg px-5">
                            <i class="bi bi-check-circle-fill"></i> Mark as Visited
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

</body>
</html>
