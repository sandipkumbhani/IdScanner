@model SocPass.Domain.Model.Member
@{
    Layout = null;
    IList<SocPass.Domain.Model.Member> qrList = ViewBag.qrList;
}
<html>
<head>
    <title>User QR</title>
    <link href="~/css/addpagination.css" rel="stylesheet" />
    <link href="~/css/app-style.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <style>
        body {
            background-color: #ffffff;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        .content-page {
            background-color: #ffffff;
            min-height: 100vh;
            padding: 30px;
        }

        .table-top-header h4 {
            margin: 0;
            color: #000;
            border-bottom: 1px solid #ddd;
            padding-bottom: 10px;
        }

        .qr-container {
            display: flex;
            flex-wrap: wrap;
            gap: 30px;
            justify-content: flex-start;
            margin-top: 20px;
        }

        .qr-item {
            text-align: center;
            background: #fff;
            border: 1px solid #ccc;
            border-radius: 10px;
            padding: 10px;
            width: 220px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        }

            .qr-item img {
                width: 200px;
                height: 200px;
            }

            .qr-item span {
                display: block;
                margin-top: 8px;
                font-weight: 600;
                color: #000;
            }

        .datatable-footer-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 20px;
            padding-top: 10px;
            border-top: 1px solid #ddd;
            color: #000;
        }
    </style>
</head>
<body>
    <div class="content-page">
        <div class="table-top-header">
            <h4>User QR List</h4>
        </div>

        <div class="qr-container">
            @foreach (var qr in qrList)
            {
                <div class="qr-item">
                    <img src="@qr.QRCodeUrl" alt="QR Code" />
                </div>
            }
        </div>
    </div>

    <script src="~/js/addpagination.js"></script>
    <script src="~/js/record.js" defer></script>
</body>
</html>
