@model SocPass.Domain.Model.QRCodeMaster
@{
    Layout = null;
    var eventList = ViewBag.EventList as IEnumerable<SocPass.Domain.Model.Event>;
}
<html>
<head>
    <title>User QR</title>
    <link href="~/css/addpagination.css" rel="stylesheet" />
    <link href="~/css/app-style.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <style>
        body {
            background-color: #ffffff;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        .content-page {
            background-color: #ffffff;
            min-height: 100vh;
            padding: 30px;
            position: relative;
        }

        .table-top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logout-btn {
            background-color: #d9534f;
            color: #fff;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.3s ease;
        }

        .qr-container {
            display: flex;
            flex-wrap: wrap;
            gap: 30px;
            justify-content: flex-start;
            margin-top: 20px;
        }

        .qr-item {
            text-align: center;
            background: #fff;
            border: 1px solid #ccc;
            border-radius: 10px;
            padding: 10px;
            width: 220px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        }

            .qr-item img {
                width: 200px;
                height: 200px;
            }

            .qr-item span {
                display: block;
                margin-top: 8px;
                font-weight: 600;
                color: #000;
            }
    </style>
</head>
<body>
    <div class="content-page">
        <div class="table-top-header">
            <h2>User QR List</h2>
            <a href="~/Logout/Logout">
                <button type="button" class="logout-btn">Logout</button>
            </a>
        </div>
        <hr />

        <div class="col-xl-4 col-lg-6">
            <div class="item-input">
                <label class="form-label col-form-label required fw-semibold fs-6">Select Event</label>
                <select id="EventId" name="EventId" class="form-select">
                    <option value="">-- Select Event --</option>
                    @if (ViewBag.EventList != null)
                    {
                        foreach (var events in eventList)
                        {
                            <option value="@events.EventId">@events.EventName</option>
                        }
                    }
                </select>
            </div>
        </div>

        <div id="qrContainer"></div>
    </div>
    <script>
        $(document).ready(function(){
        $("#EventId").change(function () {
        var eventId = $(this).val();
        if (eventId) {
        $.ajax({
            url: '@Url.Action("GetQrList", "UserFlatMapping")',
        type: 'GET',
        data: { EventId: eventId },
        success: function (data) {
        var html = '<div class="qr-container">';
            if (data && data.length > 0) {
            $.each(data, function (i, qr) {
            html += `
            <div class="qr-item">
                <img src="${qr.qrCodeUrl}" alt="QR Code" />
                <span>${qr.eventName}</span>
                 <span>${qr.isGuest ?  "Guest" : "Resident"}</span>
            </div>`;
            });
            } else {
            html += "<p>No QR codes found for this event.</p>";
            }
            html += '</div>';
        $("#qrContainer").html(html);
        },
        error: function (xhr) {
        console.error("Error:", xhr.status, xhr.statusText);
        }
        });
        } else {
        $("#qrContainer").html("<p>Please select an event.</p>");
        }
        });

        });
    </script>
</body>
</html>
