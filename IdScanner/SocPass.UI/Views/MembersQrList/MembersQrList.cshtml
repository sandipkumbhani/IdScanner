@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var selectedSocietyId = ViewBag.SelectedSocietyId as int? ?? 0;
}
<html>
<head>
    <title>SocPass | GenerateQr</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        .error-message {
            color: red;
            font-size: 0.875rem;
            margin-top: 0.25rem;
            display: none;
        }

        .is-invalid {
            border-color: red !important;
        }

    </style>
</head>
<body>
    <div class="content-page">
        <div class="content">
            <div class="main-inner container-fluid">
                <div class="row">
                    <div class="col-12">
                        <div class="page-title-box">
                            <h1 class="page-title">Generate Member Qr</h1>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <div class="card com-profile-info">
                            <div class="top-details">
                                <h2 class="page-form-title">Add QR Generate Details</h2>

                                <form id="qrForm" method="post" action="@Url.Action("GeneratePass", "MembersQrList")">
                                    <div class="row g-3">
                                        <!-- Society -->
                                        <div class="col-xl-4 col-lg-6">
                                            <div class="item-input">
                                                <label class="form-label fw-semibold fs-6">Select Society</label>
                                                <select id="Society" name="SocietyId" class="form-select" @(ViewBag.IsSocietyReadonly ? "disabled" : "")>
                                                    <option value="">-- Select Society --</option>
                                                    @if (ViewBag.Societies != null)
                                                    {
                                                        foreach (var society in ViewBag.Societies)
                                                        {
                                                            if (selectedSocietyId == society.SocietyId)
                                                            {
                                                                <option value="@society.SocietyId" selected>@society.Name</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@society.SocietyId">@society.Name</option>
                                                            }
                                                        }
                                                    }
                                                </select>

                                                @if (ViewBag.IsSocietyReadonly)
                                                {
                                                    <input type="hidden" name="SocietyId" value="@selectedSocietyId" />
                                                }
                                                <div class="text-danger" id="SocietyError">Please select a society.</div> 
                                            </div>
                                        </div>

                                        <!-- Block -->
                                        <div class="col-xl-4 col-lg-6">
                                            <div class="item-input">
                                                <label class="form-label fw-semibold fs-6">Select Block</label>
                                                <select id="Block" name="BlockId" class="form-select">
                                                    <option value="">-- Select Block --</option>
                                                </select>
                                                <div class="text-danger" id="BlockError">Please select a block.</div>
                                                <div id="EmptyBlockMsg"></div>
                                            </div>
                                        </div>
                                        <div class="col-xl-4 col-lg-6">
                                            <div class="item-input">
                                                <label class="form-label fw-semibold fs-6">Select Event</label>
                                                <select id="EventId" name="EventId" class="form-select">
                                                    <option value="">-- Select Event --</option>
                                                    @if (ViewBag.EventList != null)
                                                    {
                                                        foreach (var events in ViewBag.EventList)
                                                        {
                                                            <option value="@events.EventId">@events.EventName</option>
                                                        }
                                                    }
                                                </select>

                                                @if (ViewBag.IsSocietyReadonly)
                                                {
                                                    <input type="hidden" name="SocietyId" value="@selectedSocietyId" />
                                                }
                                                <div class="text-danger" id="SocietyError">Please select a society.</div>
                                            </div>
                                        </div>

                                        <!-- Pass Date -->
                                        <div class="col-xl-4 col-lg-6">
                                            <div class="item-input">
                                                <label for="PassDate" class="form-label fw-semibold fs-6">Pass Date</label>
                                                <input type="date" class="form-control userinput"
                                                       id="PassDate" name="PassDate"
                                                       min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                                <div class="text-danger" id="PassDateError">Please select a pass date.</div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Buttons -->
                                    <div class="button-main d-flex gap-3 mt-4">
                                        <button type="submit" class="card-link">
                                            <i class="ri-save-line"></i>
                                            <span>Save</span>
                                        </button>
                                        <button type="reset" class="card-link outline-bar">
                                            <i class="ri-refresh-line"></i> <span>Clear</span>
                                        </button>
                                    </div>

                                    <!-- QR Container -->
                                    <div id="flatContainer" class="mt-4"></div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
   
    <script type="text/javascript">
         $(".text-danger").hide();
              $(document).ready(function () {

            function showError(inputId, messageId) {
                $("#" + inputId).addClass("is-invalid");
                $("#" + messageId).show();
            }

            function hideError(inputId, messageId) {
                $("#" + inputId).removeClass("is-invalid");
                $("#" + messageId).hide();
            }

            $("#qrForm").submit(function (e) {
                let valid = true;

                if (!$("#Society").val()) {
                    showError("Society", "SocietyError");
                    valid = false;
                } else {
                    hideError("Society", "SocietyError");
                }

                if (!$("#Block").val()) {
                    showError("Block", "BlockError");
                    valid = false;
                } else {
                    hideError("Block", "BlockError");
                }

                if (!$("#PassDate").val()) {
                    showError("PassDate", "PassDateError");
                    valid = false;
                } else {
                    hideError("PassDate", "PassDateError");
                }

                if (!valid) {
                    e.preventDefault();
                }
            });

                $("#PassDate").on("change input", function () {
            if ($(this).val()) {
                hideError("PassDate", "PassDateError");
            } else {
                showError("PassDate", "PassDateError");
            }
        });

            $("#Society").change(function () {
                var societyId = $(this).val();
                var $blockempty = $("#EmptyBlockMsg");
            $blockempty.empty();
                $("#Block").empty().append('<option value="">-- Select Block --</option>');
                $("#flatContainer").empty();
                hideError("Society", "SocietyError");
                if (!societyId) return;
                 $.ajax({
                url: '@Url.Action("GetBlocksBySociety", "MembersQrList")',
                method: 'GET',
                data: { societyId: societyId },
                dataType: 'json'
            })
            .done(function (data) {
                if (!data || data.length === 0) {
                    $("#Block").empty().append('<option value="">-- No Blocks available --</option>');
                    return;
                }

                $.each(data, function (i, block) {
                    $("#Block").append('<option value="' + block.blockId + '">' + block.blockName + '</option>');
                });

            })
            .fail(function () {
                $("#Block").empty().append('<option value="">-- No Blocks available --</option>');
                $blockempty.append('<span class="text-danger">No Blocks found for this Society.</span>');
            });
            });

            $("#Block").change(function () {
                var blockId = $(this).val();
                var container = $("#flatContainer");
                container.empty();
                hideError("Block", "BlockError");

                if (blockId) {
                    $.getJSON('@Url.Action("GetFlatsByBlock", "MembersQrList")', { blockId: blockId }, function (data) {
                        $.each(data, function (i, flat) {
                            var flatRow = $(`
                                <div class="flat-row mb-3 p-2 border rounded">
                                    <div><strong>Flat:</strong> ${flat.flatNumber}</div>
                                    <div><strong>Total Members:</strong> ${flat.totalMember}</div>
                                    <div class="qr-row d-flex flex-wrap gap-2 mt-2"></div>
                                </div>
                            `);

                            var qrRow = flatRow.find(".qr-row");
                            $.each(flat.members, function (j, member) {
                                if (member.qrCodeUrl) {
                                    qrRow.append(`<img src="${member.qrCodeUrl}" alt="QR" width="100" height="100"
                                        style="border:1px solid #ccc; border-radius:8px;">`);
                                }
                            });

                            container.append(flatRow);
                        });
                    });
                }
            });

            // Trigger change on page load if society is already selected
            if ($("#Society").val()) {
                $("#Society").trigger("change");
            }

        });

    </script>
</body>
</html>
