@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var selectedSocietyId = ViewBag.SelectedSocietyId as int? ?? 0;
    var eventList = ViewBag.EventList as IEnumerable<SocPass.Domain.Model.Event>;
}

<html>
<head>
    <title>SocPass | Member Report</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" />
    <style>
        .table th, .table td {
            text-align: center;
            word-wrap: break-word;
        }
    </style>
</head>
<body>
    <div class="content-page">
        <div class="content">
            <div class="main-inner container-fluid">
                <div class="row">
                    <div class="col-12">
                        <div class="card com-profile-info">
                            <div class="top-details">
                                <h2 class="page-form-title">Member Reports</h2>

                                <div class="row mb-3">
                                    <!-- Society Dropdown -->
                                    <div class="col-md-4">
                                        <label class="form-label">Select Society</label>
                                        @* <select id="Society" class="form-select">
                    <option value="">-- Select Society --</option>
                    @if (ViewBag.Societies != null)
                    {
                        foreach (var society in ViewBag.Societies)
                        {
                            <option value="@society.SocietyId">@society.Name</option>
                        }
                    }
                </select> *@

                                        <select id="Society" name="SocietyId" class="form-select" @(ViewBag.IsSocietyReadonly ? "disabled" : "")>
                                            <option value="">-- Select Society --</option>
                                            @if (ViewBag.Societies != null)
                                            {
                                                foreach (var society in ViewBag.Societies)
                                                {
                                                    if (selectedSocietyId == society.SocietyId)
                                                    {
                                                        <option value="@society.SocietyId" selected>@society.Name</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@society.SocietyId">@society.Name</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </div>

                                    <!-- Block Dropdown -->
                                    <div class="col-md-4">
                                        <label class="form-label">Select Block</label>
                                        <select id="Block" class="form-select">
                                            <option value="">-- Select Block --</option>
                                        </select>
                                        <div id="EmptyBlockMsg"></div>
                                    </div>
                                    <div class="col-xl-4 col-lg-6">
                                        <div class="item-input">
                                            <label class="form-label fw-semibold fs-6">Select Event</label>
                                            <select id="eventId" name="eventId" class="form-select">
                                                <option value="">-- Select Event --</option>
                                                @if (ViewBag.EventList != null)
                                                {
                                                    foreach (var events in eventList)
                                                    {
                                                        <option value="@events.EventId">@events.EventName</option>
                                                    }
                                                }
                                            </select>

                                            @if (ViewBag.IsSocietyReadonly)
                                            {
                                                <input type="hidden" name="SocietyId" value="@selectedSocietyId" />
                                            }
                                          @*   <div class="text-danger" id="SocietyError">Please select a society.</div> *@
                                        </div>
                                    </div>

                                    <!-- Date Picker -->
                                    <div class="col-md-4">
                                        <label class="form-label">Select Date</label>
                                        <input type="date" id="ReportDate" class="form-control" />
                                    </div>
                                </div>

                                <!-- Flats Table -->
                                <div id="flatContainer"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {

            function showError(inputId, messageId) {
                $("#" + inputId).addClass("is-invalid");
                $("#" + messageId).show();
            }

            function hideError(inputId, messageId) {
                $("#" + inputId).removeClass("is-invalid");
                $("#" + messageId).hide();
            }

            function loadBlocks(societyId) {
                var $block = $("#Block");
                var $blockMsg = $("#EmptyBlockMsg");
                $blockMsg.empty();
                $block.empty().append('<option value="">-- Select Block --</option>');
                $("#flatContainer").empty();

                if (!societyId) return;

                $.ajax({
                    url: '@Url.Action("GetBlocksBySociety", "MembersQrList")',
                    method: 'GET',
                    data: { societyId: societyId },
                    dataType: 'json'
                })
                .done(function (data) {
                    if (!data || data.length === 0) {
                        $block.empty().append('<option value="">-- No Blocks available --</option>');
                       
                        return;
                    }

                    $.each(data, function (i, block) {
                        $block.append($('<option>', { value: block.blockId, text: block.blockName }));
                    });
                })
                .fail(function () {
                    $block.empty().append('<option value="">-- No Blocks available --</option>');
                    $blockMsg.append('<span class="text-danger">No Blocks found for this Society.</span>');
                });
            }

            $("#Society").change(function () {
                var societyId = $(this).val();
                hideError("Society", "SocietyError");
                loadBlocks(societyId);
            });

            function loadReport() {
                var blockId = $("#Block").val();
                var startDate = $("#ReportDate").val();
                var eventId = $("#eventId").val();
                var container = $("#flatContainer");
                container.empty();

                if (!blockId || !eventId || !startDate) return;

                $.ajax({
                    url: '@Url.Action("GetReport", "Report")',
                    method: 'GET',
                    data: { blockId: blockId, eventId: eventId, startDate: startDate },
                    dataType: 'json'
                }).done(function (flats) {
                    if (!flats || flats.length === 0) {
                        container.append('<p class="text-danger fw-bold">No records matched for the selected date.</p>');
                        return;
                    }

                    var totalMembers = 0, totalVisitedAdults = 0, totalVisitedChildren = 0, totalPending = 0;
                    var totalGuest = 0, totalVisitedGuest = 0, totalPendingGuest = 0;

                    var table = `<table class="table table-bordered table-striped mt-3" style="table-layout: fixed; width: 100%;">
                                    <colgroup>
                                      <col style="width:10%"><col style="width:10%"><col style="width:10%"><col style="width:10%">
                                      <col style="width:10%"><col style="width:10%"><col style="width:10%"><col style="width:10%">
                                      <col style="width:10%"><col style="width:10%">
                                    </colgroup>
                                    <thead>
                                        <tr>
                                          <th>Flat Number</th><th>Adults</th><th>Children</th><th>Total</th>
                                          <th>Visited Adults</th><th>Visited Children</th><th>Pending Member</th>
                                          <th>Total Guest</th><th>Visited Guest</th><th>Pending Guest</th>
                                        </tr>
                                    </thead><tbody>`;

                    $.each(flats, function (i, flat) {
                        table += `<tr>
                                    <td>${flat.flatNumber}</td>
                                    <td>${flat.numberOfAdult ?? flat.numberOfAdults ?? 0}</td>
                                    <td>${flat.numberOfChild ?? flat.numberOfChildren ?? 0}</td>
                                    <td>${flat.totalMember ?? 0}</td>
                                    <td>${flat.visitedAdult ?? 0}</td>
                                    <td>${flat.visitedChild ?? 0}</td>
                                    <td>${flat.pendingMember ?? 0}</td>
                                    <td>${flat.totalGuest ?? 0}</td>
                                    <td>${flat.visitedGuest ?? 0}</td>
                                    <td>${flat.pendingGuest ?? 0}</td>
                                  </tr>`;

                        totalMembers += Number(flat.totalMember || 0);
                        totalVisitedAdults += Number(flat.visitedAdult || 0);
                        totalVisitedChildren += Number(flat.visitedChild || 0);
                        totalPending += Number(flat.pendingMember || 0);
                        totalGuest += Number(flat.totalGuest || 0);
                        totalVisitedGuest += Number(flat.visitedGuest || 0);
                        totalPendingGuest += Number(flat.pendingGuest || 0);
                    });

                    table += `<tr class="fw-bold">
                                <td>Total</td><td>-</td><td>-</td><td>${totalMembers}</td>
                                <td>${totalVisitedAdults}</td><td>${totalVisitedChildren}</td><td>${totalPending}</td>
                                <td>${totalGuest}</td><td>${totalVisitedGuest}</td><td>${totalPendingGuest}</td>
                              </tr></tbody></table>`;

                    container.append(table);
                }).fail(function (jqXHR) {
                    container.append('<p class="text-danger">Error loading report.</p>');
                    console.error('GetReport failed', jqXHR);
                });
            }

            $("#Block,#ReportDate,#eventId").change(loadReport);

            var selectedSocietyId = '@selectedSocietyId';
            if (selectedSocietyId && selectedSocietyId !== "0") {
                loadBlocks(selectedSocietyId);
            }
        });
    </script>
</body>
</html>
