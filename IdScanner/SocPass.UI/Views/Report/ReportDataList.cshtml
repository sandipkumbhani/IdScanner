@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<html>
<head>
    <title>SocPass | Member Report</title>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" />
    <style>
        .table th, .table td {
            text-align: center;
            word-wrap: break-word;
        }
    </style>
</head>
<body>
    <div class="container mt-4">
        <h2>Member Reports</h2>

        <div class="row mb-3">
            <!-- Society Dropdown -->
            <div class="col-md-4">
                <label class="form-label">Select Society</label>
                <select id="Society" class="form-select">
                    <option value="">-- Select Society --</option>
                    @if (ViewBag.Societies != null)
                    {
                        foreach (var society in ViewBag.Societies)
                        {
                            <option value="@society.SocietyId">@society.Name</option>
                        }
                    }
                </select>
            </div>

            <!-- Block Dropdown -->
            <div class="col-md-4">
                <label class="form-label">Select Block</label>
                <select id="Block" class="form-select">
                    <option value="">-- Select Block --</option>
                </select>
            </div>

            <!-- Date Picker -->
            <div class="col-md-4">
                <label class="form-label">Select Date</label>
                <input type="date" id="ReportDate" class="form-control" />
            </div>
        </div>

        <!-- Flats Table -->
        <div id="flatContainer"></div>
    </div>

    <script>
        $(document).ready(function () {

            $("#Society").change(function () {
                var societyId = $(this).val();
                $("#Block").empty().append('<option value="">-- Select Block --</option>');
                $("#flatContainer").empty();

                if (societyId) {
                    $.getJSON('@Url.Action("GetBlocksBySociety", "Report")', { societyId: societyId }, function (blocks) {
                        $.each(blocks, function (i, block) {
                            $("#Block").append($('<option>', { value: block.blockId, text: block.blockName }));
                        });
                    });
                }
            });

            $("#Block, #ReportDate").change(function () {
                var blockId = $("#Block").val();
                var selectedDate = $("#ReportDate").val();
                var container = $("#flatContainer");
                container.empty();

                if (blockId) {
                    $.getJSON('@Url.Action("GetFlatsByBlock", "Report")',
                        { blockId: blockId, selectedDate: selectedDate },
                        function (flats) {

                            if (flats.length === 0) {
                                container.append('<p class="text-danger fw-bold">No records matched for the selected date.</p>');
                                return;
                            }

                            var totalMembers = 0, totalVisitedAdults = 0, totalVisitedChildren = 0, totalPending = 0;

                            var table = `<table class="table table-bordered table-striped mt-3" style="table-layout: fixed; width: 100%;">
                                            <colgroup>
                                                <col style="width:14.28%">
                                                <col style="width:14.28%">
                                                <col style="width:14.28%">
                                                <col style="width:14.28%">
                                                <col style="width:14.28%">
                                                <col style="width:14.28%">
                                                <col style="width:14.28%">
                                            </colgroup>
                                            <thead>
                                                <tr>
                                                    <th>Flat Number</th>
                                                    <th>Adults</th>
                                                    <th>Children</th>
                                                    <th>Total</th>
                                                    <th>Visited Adults</th>
                                                    <th>Visited Children</th>
                                                    <th>Pending</th>
                                                </tr>
                                            </thead>
                                            <tbody>`;

                            $.each(flats, function (i, flat) {
                                table += `<tr>
                                            <td>${flat.flatNumber}</td>
                                            <td>${flat.numberOfAdult}</td>
                                            <td>${flat.numberOfChild}</td>
                                            <td>${flat.totalMember}</td>
                                            <td>${flat.visitedAdults}</td>
                                            <td>${flat.visitedChildren}</td>
                                            <td>${flat.pending}</td>
                                          </tr>`;

                                totalMembers += flat.totalMember;
                                totalVisitedAdults += flat.visitedAdults;
                                totalVisitedChildren += flat.visitedChildren;
                                totalPending += flat.pending;
                            });

                            table += `<tr class="fw-bold">
                                        <td>Total</td>
                                        <td>-</td>
                                        <td>-</td>
                                        <td>${totalMembers}</td>
                                        <td>${totalVisitedAdults}</td>
                                        <td>${totalVisitedChildren}</td>
                                        <td>${totalPending}</td>
                                      </tr>`;

                            table += '</tbody></table>';
                            container.append(table);
                        });
                }
            });

        });
    </script>
</body>
</html>
