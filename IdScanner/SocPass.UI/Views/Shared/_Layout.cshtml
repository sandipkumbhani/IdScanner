<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Cache-Control" content="no-store" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* <title>@ViewData["Title"] - Emertec.UI</title> *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">
    <!-- intl-tel-input CSS -->
    <link href="~/css/intlTelInput-largeFlags.css" rel="stylesheet" type="text/css" />
    <!-- Select2 CSS -->
    <link href="~/css/select2.min.css" rel="stylesheet" type="text/css" />
    <!-- Datatables css -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/css/bootstrap-datepicker.css" rel="stylesheet">
    <!-- Select2 Bootstrap4 CSS -->
    <link href="~/css/select2-bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <!-- Remixicon CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <link href="~/css/remixicon.css" rel="stylesheet" type="text/css" />
    <!-- SimpleBar CSS -->
    <link href="~/css/simplebar.css" rel="stylesheet" type="text/css" />
    <!-- Bootstrap css -->
    <link href="~/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <!-- App css -->
    <link href="~/css/app-style.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <a class="nav-link dropdown-toggle nav-user" href="#" id="userDropdown"
                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="account-user-avatar">
                        <img src="~/images/avatar-1.png" alt="user-image" width="40" class="rounded-circle">
                    </span>
                    <span class="ms-2">@await Component.InvokeAsync("UserName")</span>
                </a>

                <div class="dropdown-menu dropdown-menu-end profile-dropdown" aria-labelledby="userDropdown">
                    <div class="dropdown-header noti-title">
                        <h6 class="text-overflow m-0">Welcome !</h6>
                    </div>
                    <a class="nav-link" href="../Logout/Logout">
                        <button type="submit" class="dropdown-item">
                            <span>Logout</span>
                        </button>
                    </a>
                </div>
            </div>
        </nav>
    </header>
    <body data-sidenav-size="default" style="background:#F2F5F9;">
        <div class="wrapper">

            <div class="topbar container-fluid">
                <div class="d-flex align-items-center gap-lg-2 gap-1">
                    <div class="logo-topbar">
                        <a href="#">
                            <span class="logo-sm" style="font-size:x-large;color:#0466C8;">
                                <i class="ri-first-aid-kit-fill" style="font-size:35px"></i>
                            </span>
                        </a>
                    </div>
                    <button class="button-toggle-menu">
                        <i class="ri-menu-line"></i>
                    </button>
                </div>
            </div>

            <div class="leftside-menu">
                <div class="left-toplogo">
                    <a href="#" class="logo logo-light">
                        <span class="logo-lg" style="font-size:x-large;color:#0466C8;">
                            <b>SocPass</b>
                        </span>
                        <span class="logo-sm" style="font-size:x-large;color:#0466C8;">
                            <i class="bi bi-pass" style="font-size:35px"></i>
                        </span>
                    </a>
                    <button type="button" class="sidebar-toggle">
                        <i class="ri-arrow-left-double-line"></i>
                    </button>
                    <button type="button" class="sidebar-close-btn">
                        <i class="ri-close-line"></i>
                    </button>
                </div>
                <div class="leftbar custom-scroll">
                    <div class="left-sidebar-wrap">
                        <div class="sidebar-menu-area">
                            <ul id="leftside-menu-container" class="side-nav" style="padding:initial;">
                                @await Component.InvokeAsync("UserMenu")
                            </ul>
                            <div class="clearfix"></div>
                        </div>
                    </div>
                </div>
                <div class="left-footer">
                    <div class="left-sidebar-wrap">
                        <div class="sidebar-menu-area">
                            <ul id="leftside-menu-container" class="side-nav" style="padding:initial;">
                                <li class="nav-item">
                                    <a class="nav-link" href="../Logout/Logout">
                                        <i class="ri-logout-circle-line" style="display:flow"></i>
                                        <span>Log Out</span>
                                    </a>
                                </li>
                            </ul>
                            <div class="clearfix"></div>
                        </div>
                    </div>
                </div>
                <style>
                    .logout-form {
                        margin: 0;
                        padding: 0;
                    }
                    .logout-link {
                        display: flex;
                        align-items: center;
                        font-size: 0.875rem;
                        color: var(--ft-left-menu-text);
                        font-weight: 500;
                        padding: 0.625rem 0.75rem;
                        border-radius: 0.75rem;
                        width: 100%;
                        border: none;
                        background: transparent;
                        cursor: pointer;
                        text-align: left;
                        transition: all 0.3s ease;
                    }

                        .logout-link i {
                            font-size: 1.375rem;
                            margin-right: 12px;
                        }

                        .logout-link:hover {
                            background: var(--ft-primary);
                            color: var(--ft-white);
                        }
                </style>

            </div>
            <div class="content-page">
                <div class="content">
                    @RenderBody()
                </div>
            </div>
        </div>
        <!-- Jquery Min JS -->
        <script src="~/js/jquery.min.js"></script>
        <!-- Bootstrap Bundle JS -->
        <script src="~/js/bootstrap.bundle.min.js"></script>
        <!-- SimpleBar JS -->
        <script src="~/js/simplebar.min.js"></script>
        <!-- Select2 JS -->
        <script src="~/js/select2.min.js"></script>
        <!-- intl-tel-input JS -->
        <script src="~/js/intlTelInput.min.js"></script>
        <!-- Dropzone JS -->
        <script src="~/js/dropzone.min.js"></script>
        <!-- Repeater JS -->
        <script src="~/js/jquery.repeater.min.js"></script>
        <!-- Datatables js -->
        <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
        <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
        <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
        <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>
        <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
        <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
        <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>
        <!-- Datatable Init js -->
        <script src="~/js/datatable-init.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.10.0/js/bootstrap-datepicker.min.js"> </script>
        <!-- Script App JS -->
        <script src="~/js/script-app.js"></script>
        @RenderSection("Scripts", required: false)
    </body>
    <footer class="border-top footer bg-light text-muted mt-3 py-3">
        <div class="container text-center">
            <span>&copy; @DateTime.Now.Year - Broadsy Technologies</span>
            <span class="mx-2">|</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-primary">
                Privacy Policy
            </a>
            <span class="mx-2">|</span>
            <a asp-area="" asp-controller="Home" asp-action="Terms" class="text-decoration-none text-primary">
                Terms of Use
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
